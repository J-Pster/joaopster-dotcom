# Wakatime API key - never sent to the browser.
# Used at build time (static snapshot) and at runtime by the Cloudflare Pages
# Function functions/api/wakatime.ts (set it in Pages > Settings > Variables and Secrets).
# Get yours at: https://wakatime.com/settings/api-key
WAKATIME_API_KEY=your_wakatime_api_key_here

# Buttondown API key - never sent to the browser.
# Used at runtime by the Cloudflare Pages Function functions/api/subscribe.ts
# (set it in Pages > Settings > Variables and Secrets) and locally by
# `npm run newsletter:draft -- <slug>`.
# Get yours at: https://buttondown.com/settings/api
BUTTONDOWN_API_KEY=your_buttondown_api_key_here
