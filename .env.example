# Wakatime API key - never sent to the browser.
# Used at build time (static snapshot) and at runtime by the Cloudflare Pages
# Function functions/api/wakatime.ts (set it in Pages > Settings > Variables and Secrets).
# Get yours at: https://wakatime.com/settings/api-key
WAKATIME_API_KEY=your_wakatime_api_key_here
