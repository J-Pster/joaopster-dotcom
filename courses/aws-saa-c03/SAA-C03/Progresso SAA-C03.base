filters:
  and:
    - file.hasTag("aula")
    - file.hasTag("saa-c03")
properties:
  note.modulo:
    displayName: Módulo
  note.aula:
    displayName: Aula
  note.lida:
    displayName: Lida
  note.parte:
    displayName: Parte
  note.dominios:
    displayName: Domínios
  file.name:
    displayName: Nota
views:
  - type: table
    name: Por módulo
    groupBy:
      property: modulo
      direction: ASC
    order:
      - file.name
      - lida
    sort:
      - property: modulo
        direction: ASC
      - property: aula
        direction: ASC
    summaries:
      lida: Checked
  - type: table
    name: Próximas a ler
    filters:
      and:
        - lida != true
    order:
      - file.name
      - parte
      - lida
    sort:
      - property: modulo
        direction: ASC
      - property: aula
        direction: ASC
    limit: 15
  - type: table
    name: Por parte
    groupBy:
      property: parte
      direction: ASC
    order:
      - file.name
      - lida
    sort:
      - property: modulo
        direction: ASC
      - property: aula
        direction: ASC
    summaries:
      lida: Checked
  - type: table
    name: "Domínio 1: Seguro (30%)"
    filters:
      and:
        - dominios.contains(1)
    order:
      - file.name
      - lida
    sort:
      - property: modulo
        direction: ASC
      - property: aula
        direction: ASC
    summaries:
      lida: Checked
  - type: table
    name: "Domínio 2: Resiliente (26%)"
    filters:
      and:
        - dominios.contains(2)
    order:
      - file.name
      - lida
    sort:
      - property: modulo
        direction: ASC
      - property: aula
        direction: ASC
    summaries:
      lida: Checked
  - type: table
    name: "Domínio 3: Alto desempenho (24%)"
    filters:
      and:
        - dominios.contains(3)
    order:
      - file.name
      - lida
    sort:
      - property: modulo
        direction: ASC
      - property: aula
        direction: ASC
    summaries:
      lida: Checked
  - type: table
    name: "Domínio 4: Custo otimizado (20%)"
    filters:
      and:
        - dominios.contains(4)
    order:
      - file.name
      - lida
    sort:
      - property: modulo
        direction: ASC
      - property: aula
        direction: ASC
    summaries:
      lida: Checked
