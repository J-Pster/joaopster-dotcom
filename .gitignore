# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# claude local settings (may contain secrets)
.claude/settings.local.json

# agent state & cache (machine/session-specific)
.omc/
.serena/

# generated LinkedIn article covers (npm run cover)
linkedin-covers/

# wrangler local state (local D1 copy) and local secrets
.wrangler/
.dev.vars

# course vaults: copied from the author's vaults (npm run courses:sync) and published to R2
# (npm run courses:publish), never built nor kept in git. Only the course-writing skill stays.
/courses/*
!/courses/_skill/
