---
// Phone and tablet reading bar of a course note (below 1024px, where the side columns are not shown):
// sticky under the header, with the course modules, the section being read (it opens the note's table
// of contents), listening, the AI assistant and search. Modules and contents open as bottom sheets; lib/courses/client/readerBar.ts
// moves the sidebar and the table of contents into them while open.
import type { Lang } from '../../i18n/ui';
import { courseText } from '../../lib/courses/i18n';
import { searchText } from '../../lib/courses/searchText';
import { assistantText } from '../../lib/courses/assistantText';
import { listenText } from '../../lib/courses/listenText';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const text = courseText(lang);
const search = searchText(lang);
const assistant = assistantText(lang);
const listen = listenText(lang);
const sheets = [
  { name: 'nav', title: text.navToggle },
  { name: 'toc', title: text.onThisNote },
] as const;
---

<div class="reader-bar" data-reader-bar>
  <button type="button" class="reader-bar-nav" data-sheet-open="nav" aria-haspopup="dialog" aria-controls="course-sheet-nav">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
    <span>{text.navShort}</span>
  </button>
  <button type="button" class="reader-bar-toc" data-sheet-open="toc" aria-haspopup="dialog" aria-controls="course-sheet-toc">
    <span class="reader-bar-toc-text">
      <span class="reader-bar-toc-label">{text.onThisNote}</span>
      <span class="reader-bar-toc-current" data-reader-current>{title}</span>
    </span>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg>
  </button>
  <p class="reader-bar-title" data-reader-title>{title}</p>
  <button type="button" class="reader-bar-listen" data-listen-open aria-controls="listen-player" aria-expanded="false" aria-label={listen.open} title={listen.open}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14v-2a9 9 0 0 1 18 0v2"/><rect x="3" y="14" width="4" height="7" rx="1.5"/><rect x="17" y="14" width="4" height="7" rx="1.5"/></svg>
  </button>
  <button type="button" class="reader-bar-assistant" data-assistant-open aria-controls="course-assistant" aria-expanded="false" aria-label={assistant.open} title={assistant.open}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
  </button>
  <button type="button" class="reader-bar-search" data-search-open aria-label={search.open} title={search.open}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  </button>
  <span class="reader-bar-progress" data-reader-progress aria-hidden="true"></span>
</div>

{sheets.map((sheet) => (
  <dialog class="course-sheet" id={`course-sheet-${sheet.name}`} data-sheet={sheet.name} aria-labelledby={`course-sheet-${sheet.name}-title`} autofocus>
    <div class="course-sheet-head" data-sheet-grip>
      <span class="course-sheet-handle" aria-hidden="true"></span>
      <h2 class="course-sheet-title" id={`course-sheet-${sheet.name}-title`}>{sheet.title}</h2>
      <button type="button" class="course-sheet-close" data-sheet-close aria-label={text.close} title={text.close}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="course-sheet-body" data-sheet-body></div>
  </dialog>
))}
