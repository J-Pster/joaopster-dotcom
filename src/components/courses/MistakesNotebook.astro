---
// Mistakes notebook of a course: the quiz questions the reader got wrong, listed by note, each linking
// back to the question in its lesson. Built in the browser from the ticks and the course's study.json.
import CourseNote from '../../layouts/CourseNote.astro';
import { mistakesUrl, reviewUrl, studyIndexUrl } from '../../lib/courses/catalog';
import { studyText } from '../../lib/courses/studyText';
import { courseText } from '../../lib/courses/i18n';
import type { CourseView, NoteMeta } from '../../lib/courses/model';

interface Props {
  view: CourseView;
}

const { view } = Astro.props;
const text = studyText(view.course.lang);

// The page reuses the reader layout with a synthetic note, like the glossary index.
const pageNote: NoteMeta = {
  id: 'Caderno de erros',
  name: text.mistakesLink,
  url: mistakesUrl(view.course),
  title: text.mistakesTitle(view.course.title),
  kind: 'page',
  moduleId: undefined,
  tags: [],
  aliases: [],
  minutes: 0,
  description: courseText(view.course.lang).noteDescription(text.mistakesTitle(view.course.title), view.course.title),
};
---

<CourseNote view={view} note={pageNote} html="" headings={[]}>
  <section class="study-page" data-mistakes data-study-index={studyIndexUrl(view.course)}>
    <h1>{text.mistakesLink}</h1>
    <p class="study-lead">{text.mistakesLead}</p>
    <div class="study-toolbar">
      <p class="study-count" data-mistakes-count aria-live="polite"></p>
      <a class="study-action" href={reviewUrl(view.course)}>{text.reviewMistakes}</a>
    </div>
    <div data-mistakes-list>
      <div class="study-skeleton" aria-label={text.loading}></div>
      <div class="study-skeleton"></div>
    </div>
  </section>
</CourseNote>

<script>
  import { initMistakes } from '../../lib/courses/client/mistakes';

  void initMistakes();
</script>
