---
// One note of a course, from its published package. Used by the [...note] route of every language.
// A note tagged "simulado" with a quiz, in a course with exam rules, runs as a timed exam.
import CourseNote from '../../layouts/CourseNote.astro';
import type { NotePage } from '../../lib/courses/requests';

type Props = NotePage;

const { view, note, rendered, exam } = Astro.props;
---

<CourseNote view={view} note={note} html={rendered.html} headings={rendered.headings} exam={exam} indexing={note.kind === 'glossary' ? 'noindex' : 'index'} />
