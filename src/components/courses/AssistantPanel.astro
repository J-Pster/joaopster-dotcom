---
// The AI assistant of a course note: a chat that takes the right column (a full screen sheet below
// 1024px). Behaviour in lib/courses/client/assistant/panel.ts.
import type { Lang } from '../../i18n/ui';
import { assistantText } from '../../lib/courses/assistantText';

interface Props {
  lang: Lang;
  courseTitle: string;
  noteTitle: string;
}

const { lang, courseTitle, noteTitle } = Astro.props;
const t = assistantText(lang);
---

<aside class="assistant" id="course-assistant" data-assistant data-course-title={courseTitle} data-note-title={noteTitle} aria-labelledby="assistant-title" hidden>
  <div class="assistant-head">
    <h2 class="assistant-title" id="assistant-title" tabindex="-1">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
      {t.title}
    </h2>
    <button type="button" class="assistant-icon" data-assistant-new aria-label={t.newChat} title={t.newChat}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
    </button>
    <button type="button" class="assistant-icon" data-keys-open aria-haspopup="dialog" aria-controls="course-keys" aria-label={t.keysButton} title={t.keysButton}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2 20 3M16 7l3 3M14 9l2 2"/></svg>
    </button>
    <button type="button" class="assistant-icon" data-assistant-close aria-label={t.close} title={t.close}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <div class="assistant-log" data-assistant-log>
    <div class="assistant-empty" data-assistant-empty>
      <p class="assistant-empty-title">{t.introTitle}</p>
      <p class="assistant-empty-text">{t.intro}</p>
      <div class="assistant-setup" data-assistant-setup hidden>
        <p>{t.needKey}</p>
        <button type="button" class="assistant-primary" data-assistant-add-key>{t.addKey}</button>
      </div>
      <div class="assistant-suggestions" data-assistant-suggestions>
        {t.suggestions.map((suggestion) => (
          <button type="button" class="assistant-suggestion" data-assistant-suggestion>{suggestion}</button>
        ))}
      </div>
    </div>
    <ol class="assistant-turns" data-assistant-turns aria-label={t.title}></ol>
  </div>

  <div class="assistant-alert" data-assistant-alert role="alert" hidden>
    <p data-assistant-alert-text></p>
    <div class="assistant-alert-actions">
      <button type="button" class="assistant-secondary" data-assistant-retry hidden>{t.retry}</button>
      <button type="button" class="assistant-secondary" data-assistant-alert-keys hidden>{t.openKeys}</button>
    </div>
  </div>

  <form class="assistant-form" data-assistant-form>
    <ul class="assistant-passages" data-assistant-passages aria-label={t.snippet} hidden></ul>
    <div class="assistant-input">
      <textarea class="assistant-textarea" data-assistant-input rows="1" placeholder={t.placeholder} aria-label={t.placeholder}></textarea>
      <button type="submit" class="assistant-send" data-assistant-send aria-label={t.send} title={t.send}>
        <svg class="assistant-send-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
        <svg class="assistant-stop-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2" fill="currentColor"/></svg>
      </button>
    </div>
    <div class="assistant-meta">
      <label class="assistant-model">
        <span class="sr-only">{t.model}</span>
        <select data-assistant-model>
          <option value="fast">{t.models.fast}</option>
          <option value="smart">{t.models.smart}</option>
        </select>
      </label>
      <button type="button" class="assistant-safe" data-safety-open aria-haspopup="dialog" aria-controls="course-safety">{t.isItSafe}</button>
    </div>
    <p class="assistant-hint">{t.sendHint}</p>
  </form>
</aside>
