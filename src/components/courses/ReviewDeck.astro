---
// Spaced review of a course: cards for the glossary terms of the lessons read and for the quiz
// questions answered wrong, scheduled with FSRS in the browser (client/review.ts).
import CourseNote from '../../layouts/CourseNote.astro';
import { reviewUrl, studyIndexUrl } from '../../lib/courses/catalog';
import { studyText } from '../../lib/courses/studyText';
import { courseText } from '../../lib/courses/i18n';
import type { CourseView, NoteMeta } from '../../lib/courses/model';

interface Props {
  view: CourseView;
}

const { view } = Astro.props;
const text = studyText(view.course.lang);

const pageNote: NoteMeta = {
  id: 'Revisao',
  name: text.reviewLink,
  url: reviewUrl(view.course),
  title: text.reviewTitle(view.course.title),
  kind: 'page',
  moduleId: undefined,
  tags: [],
  aliases: [],
  minutes: 0,
  description: courseText(view.course.lang).noteDescription(text.reviewTitle(view.course.title), view.course.title),
};
---

<CourseNote view={view} note={pageNote} html="" headings={[]}>
  <section class="study-page" data-review data-study-index={studyIndexUrl(view.course)}>
    <h1>{text.reviewLink}</h1>
    <p class="study-lead">{text.reviewLead}</p>
    <div class="review-stats" data-review-count aria-live="polite"><div class="study-skeleton" aria-label={text.loading}></div></div>
    <div class="review-card" data-review-card tabindex="-1" hidden>
      <p class="review-kind" data-review-kind></p>
      <div class="review-front prose" data-review-front></div>
      <div class="review-back prose" data-review-back hidden></div>
      <div class="review-actions" data-review-actions>
        <button type="button" class="review-show" data-review-show>{text.reviewShow}<kbd>{text.spaceKey}</kbd></button>
        <div class="review-ratings" data-review-ratings hidden>
          {(['again', 'hard', 'good', 'easy'] as const).map((rating, i) => (
            <button type="button" class={`review-rate review-rate--${rating}`} data-rating={rating}>
              <span>{text.ratings[rating]}</span>
              <small data-interval></small>
              <kbd>{i + 1}</kbd>
            </button>
          ))}
        </div>
      </div>
    </div>
    <p class="study-note">{text.localOnly}</p>
  </section>
</CourseNote>

<script>
  import { initReview } from '../../lib/courses/client/review';

  void initReview();
</script>
