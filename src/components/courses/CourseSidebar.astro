---
// Course navigation: the course home, the glossary and every module with its lessons.
// The current module starts open. Lesson links carry data-lesson so the reader script can tick
// the ones already read and count them per module.
// Glossary pages list the modules only: the course has thousands of terms and those pages
// would otherwise carry the whole lesson tree each.
import { glossaryUrl as glossaryUrlOf, hasStudyPages, mistakesUrl, reviewUrl } from '../../lib/courses/catalog';
import { courseText } from '../../lib/courses/i18n';
import CourseEmblem from './CourseEmblem.astro';
import { studyText } from '../../lib/courses/studyText';
import type { CourseView, NoteMeta } from '../../lib/courses/model';

interface Props {
  view: CourseView;
  note: NoteMeta;
}

const { view, note } = Astro.props;
const withLessons = note.kind !== 'glossary';
const glossaryUrl = glossaryUrlOf(view.course);
const text = courseText(view.course.lang);
const study = studyText(view.course.lang);
// "Aula 3.2: Title" in the sidebar reads as "Title": the module and the position already say the rest.
const LESSON_PREFIX = /^(?:Aula|Lesson|Lecci[oó]n|Clase) [\d.]+:\s*/;
---

<details class="course-nav" data-course-nav>
  <summary class="course-nav-toggle">{text.navToggle}</summary>
  <nav class="course-nav-inner" aria-label={text.navToggle}>
    <a class="course-nav-home" href={view.home.url} aria-current={note.kind === 'home' ? 'page' : undefined}>
      <CourseEmblem look={view.course.look} />
      <span>{view.course.title}</span>
    </a>
    <p class="course-nav-progress" data-course-total={view.lessons.length}>
      <span data-course-read>0</span>{text.lessonsReadOf(view.lessons.length)}
    </p>
    {view.glossary.length > 0 && (
      <a class="course-nav-glossary" href={glossaryUrl} aria-current={note.kind === 'glossary' ? 'page' : undefined}>
        {text.glossary} <span>{text.glossaryTerms(view.glossary.length)}</span>
      </a>
    )}
    {hasStudyPages(view.course) && (
      <div class="course-nav-study">
        <a href={mistakesUrl(view.course)} aria-current={note.url === mistakesUrl(view.course) ? 'page' : undefined}>{study.mistakesLink}</a>
        <a href={reviewUrl(view.course)} aria-current={note.url === reviewUrl(view.course) ? 'page' : undefined}>{study.reviewLink}</a>
      </div>
    )}
    <ol class="course-nav-modules">
      {view.modules.map((module) => {
        const current = module.id === note.moduleId;
        return (
          <li class="course-nav-module">
            {withLessons ? (
              <details open={current}>
                <summary>
                  <a href={module.note.url} aria-current={note.id === module.note.id ? 'page' : undefined}>
                    <span class="course-nav-number">{module.number}</span>
                    <span class="course-nav-title">{module.title}</span>
                  </a>
                  <span class="course-nav-count" data-module-count>0/{module.lessons.length}</span>
                </summary>
                <ol class="course-nav-lessons">
                  {module.lessons.map((lesson) => (
                    <li>
                      <a href={lesson.url} data-lesson={lesson.url} aria-current={lesson.id === note.id ? 'page' : undefined}>
                        {lesson.title.replace(LESSON_PREFIX, '')}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            ) : (
              <div class="course-nav-row">
                <a href={module.note.url}>
                  <span class="course-nav-number">{module.number}</span>
                  <span class="course-nav-title">{module.title}</span>
                </a>
              </div>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
</details>
