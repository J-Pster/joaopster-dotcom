---
import { useTranslations, defaultLang, type Lang, type UiKey, DATE_LOCALES } from '../../i18n/ui';
import { uptimeText } from '../../lib/lifeUptime';
import { aboutPath } from '../../lib/aboutPath';

interface Props {
  /** "summary": the two latest roles and a link to the about page (home). "full": every role (about page). */
  variant: 'summary' | 'full';
}

const SUMMARY_ROLES = 2;

const { variant } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

// "Há {years} anos": the number is spelled out and refreshed in the browser via data-uptime.
const [headingBefore, headingAfter] = t('exp.heading1').split('{years}');
const yearsWord = uptimeText(new Date(), lang).devYearsWord;

/** A month as YYYY-MM. */
type Month = `${number}-${number}`;
type Role = {
  roleKey: UiKey;
  /** Real company names stay as written; generic labels are translated. */
  company: { kind: 'name'; name: string } | { kind: 'key'; key: UiKey };
  meta: readonly UiKey[];
  period: { start: Month; end: Month | 'present' };
  descKey: UiKey;
  tags: readonly string[];
};

const roles: readonly Role[] = [
  {
    roleKey: 'exp.role1.role',
    company: { kind: 'key', key: 'exp.company.confidential' },
    meta: ['exp.terms.fullTime', 'exp.mode.remote'],
    period: { start: '2025-12', end: 'present' },
    descKey: 'exp.role1.desc',
    tags: ['AWS', 'OpenTofu', 'TypeScript', 'NestJS', 'Angular', 'AI in production'],
  },
  {
    roleKey: 'exp.role2.role',
    company: { kind: 'name', name: 'adMixt' },
    meta: ['exp.place.us', 'exp.mode.remote', 'exp.terms.contract'],
    period: { start: '2025-03', end: '2025-12' },
    descKey: 'exp.role2.desc',
    tags: ['Vanilla JS', 'PHP', 'Legacy modernization', 'Front-end architecture'],
  },
  {
    roleKey: 'exp.role3.role',
    company: { kind: 'name', name: 'Howhow' },
    meta: ['exp.place.saoPaulo', 'exp.mode.remote', 'exp.terms.contract'],
    period: { start: '2024-02', end: '2025-04' },
    descKey: 'exp.role3.desc',
    tags: ['Architecture', 'AI / NLP', 'Node.js', 'Tech lead'],
  },
  {
    roleKey: 'exp.role4.role',
    company: { kind: 'name', name: 'João Pster' },
    meta: ['exp.place.brazil', 'exp.mode.remote', 'exp.terms.ownCompany'],
    period: { start: '2020-01', end: '2025-03' },
    descKey: 'exp.role4.desc',
    tags: ['Consulting', 'Team leadership', 'Teaching', 'Full-stack'],
  },
  {
    roleKey: 'exp.role5.role',
    company: { kind: 'name', name: 'Artweb · João Pster' },
    meta: ['exp.place.brazil', 'exp.mode.remote', 'exp.terms.outsourced'],
    period: { start: '2023-01', end: '2025-03' },
    descKey: 'exp.role5.desc',
    tags: ['React', 'React Native', 'Angular', 'Flutter', 'Google Cloud', 'Firebase'],
  },
  {
    roleKey: 'exp.role6.role',
    company: { kind: 'name', name: 'AfterSale' },
    meta: ['exp.place.brazil', 'exp.mode.remote', 'exp.terms.fixedTerm'],
    period: { start: '2023-10', end: '2024-02' },
    descKey: 'exp.role6.desc',
    tags: ['React', 'Legacy integration'],
  },
  {
    roleKey: 'exp.role7.role',
    company: { kind: 'name', name: 'Digital Republic' },
    meta: ['exp.place.saoPaulo', 'exp.mode.onSite'],
    period: { start: '2023-02', end: '2023-07' },
    descKey: 'exp.role7.desc',
    tags: ['Next.js', 'Angular', 'Atomic Design'],
  },
  {
    roleKey: 'exp.role8.role',
    company: { kind: 'name', name: 'Verzel Soluções em Sistemas' },
    meta: ['exp.place.brazil', 'exp.mode.remote', 'exp.terms.contract'],
    period: { start: '2022-11', end: '2023-02' },
    descKey: 'exp.role8.desc',
    tags: ['Angular', 'React', 'Node.js', 'AI chatbot'],
  },
  {
    roleKey: 'exp.role9.role',
    company: { kind: 'key', key: 'exp.company.selfEmployed' },
    meta: ['exp.place.brazil', 'exp.mode.remote'],
    period: { start: '2019-12', end: '2022-11' },
    descKey: 'exp.role9.desc',
    tags: ['React', 'Angular', 'Vue', 'Node.js', 'C# / .NET', 'WordPress'],
  },
];

// "Dez 2025": short month and year in the page language, read in UTC so the month never shifts.
const monthFormat = new Intl.DateTimeFormat(DATE_LOCALES[lang], { month: 'short', year: 'numeric', timeZone: 'UTC' });
function formatMonth(month: Month): string {
  const parts = monthFormat.formatToParts(new Date(`${month}-01T00:00:00Z`));
  const name = parts.find((p) => p.type === 'month')?.value.replace('.', '') ?? '';
  const year = parts.find((p) => p.type === 'year')?.value ?? '';
  return `${name.charAt(0).toUpperCase()}${name.slice(1)} ${year}`;
}
const periodText = ({ start, end }: Role['period']) =>
  `${formatMonth(start)} - ${end === 'present' ? t('exp.present') : formatMonth(end)}`;
const companyText = (company: Role['company']) => (company.kind === 'name' ? company.name : t(company.key));

const shownRoles = variant === 'summary' ? roles.slice(0, SUMMARY_ROLES) : roles;

type DescBlock = { kind: 'p'; text: string } | { kind: 'ul'; items: string[] };

const BULLET = '• ';

/** Splits a description into paragraphs and bullet lists; consecutive "• " lines form one list. */
function parseDesc(text: string): DescBlock[] {
  return text.split('\n').reduce<DescBlock[]>((blocks, line) => {
    if (!line.startsWith(BULLET)) return [...blocks, { kind: 'p', text: line }];
    const last = blocks.at(-1);
    const item = line.slice(BULLET.length);
    if (last?.kind === 'ul') return [...blocks.slice(0, -1), { kind: 'ul', items: [...last.items, item] }];
    return [...blocks, { kind: 'ul', items: [item] }];
  }, []);
}
---
<section id="experience" class="experience">
  <div class="exp-inner">
    <p class="exp-label">{t('exp.label')}</p>
    <h2 class="exp-heading">{headingBefore}<span data-uptime="devYearsWord">{yearsWord}</span>{headingAfter}<br/>{t('exp.heading2')}</h2>
    <p class="exp-sub">{t('exp.sub')}</p>

    <div class="exp-timeline">
      {shownRoles.map((r) => (
        <div class:list={['exp-item', r.period.end === 'present' && 'is-current']}>
          <div class="exp-head">
            <h3 class="exp-role">{t(r.roleKey)}</h3>
            <span class="exp-dates">{periodText(r.period)}</span>
          </div>
          <p class="exp-company">
            <span class="exp-company-name">{companyText(r.company)}</span>
            <span class="exp-company-meta">{r.meta.map((key) => t(key)).join(' · ')}</span>
          </p>
          <div class="exp-desc">
            {parseDesc(t(r.descKey)).map((block) => block.kind === 'p'
              ? <p>{block.text}</p>
              : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
            )}
          </div>
          <div class="exp-tags">
            {r.tags.map(tag => <span class="exp-tag">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>

    {variant === 'summary' && (
      <div class="exp-more-wrap">
        <a href={`${aboutPath(lang)}#experience`} class="exp-more-btn">{t('exp.fullHistory')}</a>
      </div>
    )}
  </div>
</section>

<style>
  .experience {
    background: var(--color-canvas);
    padding: var(--space-section) var(--space-xl);
    border-top: 1px solid var(--color-hairline);
  }
  .exp-inner { max-width: 760px; margin: 0 auto; }
  .exp-label {
    font-size: 11px; font-weight: 600; letter-spacing: 0.88px; text-transform: uppercase;
    color: var(--color-muted); margin-bottom: var(--space-md);
  }
  .exp-heading {
    font-size: 36px; font-weight: 600; color: var(--color-ink);
    letter-spacing: -1.08px; line-height: 1.15; margin: 0 0 var(--space-base);
  }
  .exp-sub { font-size: 16px; color: var(--color-body); line-height: 1.65; margin: 0 0 var(--space-xxl); }

  .exp-timeline {
    border-left: 1px solid var(--color-hairline-strong);
    padding-left: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .exp-item { position: relative; }
  .exp-item::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-xl) - 5px);
    top: 5px;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--color-hairline-strong);
    border: 2px solid var(--color-canvas);
    box-shadow: 0 0 0 1px var(--color-hairline-strong);
  }
  .exp-item.is-current::before {
    background: #28c840;
    box-shadow: 0 0 0 1px #28c840, 0 0 0 5px rgba(40, 200, 64, 0.12);
  }

  .exp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: 2px;
  }
  .exp-role { font-size: 17px; font-weight: 600; color: var(--color-ink); letter-spacing: -0.2px; line-height: 1.35; margin: 0; }
  .exp-dates {
    font-size: 12px; font-weight: 500; color: var(--color-muted);
    font-family: 'JetBrains Mono', monospace; white-space: nowrap; flex-shrink: 0;
  }
  .exp-company { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-xs) var(--space-sm); margin: 0 0 var(--space-sm); }
  .exp-company-name { font-size: 14px; font-weight: 600; color: var(--color-text-link); }
  .exp-company-meta { font-size: 13px; color: var(--color-muted); }
  .exp-desc { margin: 0 0 var(--space-md); }
  .exp-desc p { font-size: 14px; color: var(--color-body); line-height: 1.65; margin: 0 0 var(--space-sm); }
  .exp-desc ul { list-style: none; margin: 0 0 var(--space-sm); padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .exp-desc li { position: relative; padding-left: 16px; font-size: 14px; color: var(--color-body); line-height: 1.6; }
  .exp-desc li::before { content: ''; position: absolute; left: 2px; top: 9px; width: 5px; height: 5px; border-radius: 50%; background: var(--color-hairline-strong); }
  .exp-desc > :last-child { margin-bottom: 0; }
  .exp-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .exp-tag {
    font-size: 11px; font-weight: 500; color: var(--color-ink);
    background: var(--color-surface-strong); border-radius: var(--radius-pill); padding: 3px 10px;
  }

  .exp-more-wrap { display: flex; justify-content: center; margin-top: var(--space-xl); }
  .exp-more-btn {
    display: inline-flex; align-items: center; gap: var(--space-xs);
    background: var(--color-surface-card); color: var(--color-ink);
    font-size: 14px; font-weight: 500; font-family: inherit;
    padding: 9px 17px; height: 40px;
    border: 1px solid var(--color-hairline-strong); border-radius: var(--radius-md);
    text-decoration: none; transition: border-color 0.15s;
  }
  .exp-more-btn:hover { border-color: var(--color-muted); text-decoration: none; }

  .exp-note {
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-hairline);
    font-size: 14px; color: var(--color-muted); line-height: 1.6;
  }

  @media (max-width: 640px) {
    .experience { padding: var(--space-section) var(--space-base); }
    .exp-heading { font-size: 28px; }
    .exp-head { flex-direction: column; gap: 2px; }
    .exp-timeline { padding-left: var(--space-lg); }
    .exp-item::before { left: calc(-1 * var(--space-lg) - 5px); }
  }
</style>
