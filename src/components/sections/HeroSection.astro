---
import { Image } from 'astro:assets';
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';
import profilePhoto from '../../assets/profile-photo.png';
import { countUniqueSkills } from '../../data/skills';
import { uptimeText } from '../../lib/lifeUptime';
import { aboutPath } from '../../lib/aboutPath';
import { SPOKEN_LANGUAGES } from '../../consts';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const about = aboutPath(lang);
const skillCount = countUniqueSkills(lang);
// Build-time snapshot; the client script below redraws these with today's date.
const uptime = uptimeText(new Date(), lang);

// The terminal's `git log`, newest first. Hashes are decorative; years match the Experience section.
const lifeLog = [
  { hash: 'c7b1d03', year: 2025, key: 'hero.log.startup', kind: 'career' },
  { hash: '9a3e5f2', year: 2025, key: 'hero.log.admixt', kind: 'career' },
  { hash: '3d8c4b7', year: 2024, key: 'hero.log.married', kind: 'life' },
  { hash: '7f3a0e5', year: 2023, key: 'hero.log.trybe', kind: 'life' },
  { hash: 'e1f9a26', year: 2020, key: 'hero.log.ownCompany', kind: 'career' },
  { hash: 'b52d7c8', year: 2019, key: 'hero.log.freelance', kind: 'career' },
  { hash: '0a1b2c3', year: 2019, key: 'hero.log.firstPlugin', kind: 'career' },
] as const;
---
<section class="hero">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-3" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-4" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-id">
      <Image src={profilePhoto} alt="João Pster" width={128} height={128} densities={[1, 2]} class="hero-photo" loading="eager" fetchpriority="high" />
      <div class="hero-id-text">
        <h1>João Pster</h1>
        <p class="hero-role">{t('hero.role')}</p>
      </div>
    </div>
    <p class="hero-sub">{t('hero.sub')}</p>
    <div class="hero-stats">
      <a class="stat" href={`${about}#experience`}>
        <span class="stat-n" data-uptime="devYears">{uptime.devYears}</span>
        <span class="stat-l">{t('hero.yearsExperience')}</span>
      </a>
      <div class="stat-divider"></div>
      <a class="stat" href={`${about}#skills`}>
        <span class="stat-n">{skillCount}</span>
        <span class="stat-l">{t('hero.skills')}</span>
      </a>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-n">{SPOKEN_LANGUAGES}</span>
        <span class="stat-l">{t('hero.languages')}</span>
      </div>
    </div>
    <div class="hero-ctas">
      <a href={about} class="btn-primary btn-hero">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
        {t('hero.knowMe')}
      </a>
      <a href="mailto:joao@joaopster.com" class="btn-secondary btn-hero" data-contact-open>
        {t('nav.getInTouch')}
      </a>
      <div class="hero-social">
        <a href="https://github.com/J-Pster" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/joaopster/" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="hero-mockup-wrap">
    <div class="mockup-window">
      <div class="mockup-bar">
        <div class="mockup-dots">
          <span class="dot-r"></span>
          <span class="dot-y"></span>
          <span class="dot-g"></span>
        </div>
        <span class="mockup-title">~/joaopster · zsh</span>
      </div>
      <div class="mockup-body">
        <div class="ml"><span class="mp">❯</span> <span class="mc">git clone</span> <span class="mhi">joaopster</span> <span class="mc">--depth=</span><span class="mhi"><span data-uptime="devYears">{uptime.devYears}</span>y</span></div>
        <div class="ml mo">Cloning into 'who-i-am'…</div>
        <div class="ml mo">remote: <span data-uptime="age">{uptime.age}</span> years old · <span data-uptime="devYears">{uptime.devYears}</span> years as a developer · {skillCount} skills, done.</div>
        <div class="ml mo"><span class="mg">✓</span> Resolving identity: 100%</div>
        <div class="ml mt8"><span class="mp">❯</span> <span class="mc">git log</span> <span class="mhi">--oneline</span></div>
        {lifeLog.map((entry, index) => (
          <div class="ml">
            <span class="mb">{entry.hash}</span>{index === 0 && <span class="mg"> (HEAD)</span>} <span class="myear">{entry.year}</span> <span class={entry.kind === 'life' ? 'mlife' : undefined}>{t(entry.key)}</span>
          </div>
        ))}
        <div class="ml mt8"><span class="mp">❯</span> <span class="mc">uptime</span></div>
        <div class="ml mo">up <span class="mhi"><span data-uptime="devHours">{uptime.devHours}</span> hrs</span> (<span data-uptime="devYears">{uptime.devYears}</span> years) · load avg: <span class="mg">shipping</span></div>
        <div class="ml mt8"><span class="mp">❯</span> <span class="mc-cursor">█</span></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from "motion";
  import type { Lang } from "../../i18n/ui";
  import { refreshUptime } from "../../lib/lifeUptime";

  // The page is static, so refresh every [data-uptime] on it (hero, stats, experience) with today's date.
  // <html lang> is written by the layout from the page's Lang.
  refreshUptime(document, document.documentElement.lang as Lang);

  // Staggered entrance: badge → h1 → sub → stats → CTAs
  animate(
    ".hero-inner > *",
    {
      opacity: [0, 1],
      transform: ["translateY(20px)", "translateY(0px)"],
    },
    {
      delay: stagger(0.1, { start: 0.05 }),
      duration: 0.55,
      easing: "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    }
  );

  // Terminal mockup slides up after content
  animate(
    ".hero-mockup-wrap",
    {
      opacity: [0, 1],
      transform: ["translateY(32px)", "translateY(0px)"],
    },
    {
      delay: 0.45,
      duration: 0.65,
      easing: "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    }
  );

  // Terminal lines appear one-by-one (typewriter feel)
  animate(
    ".mockup-body .ml",
    { opacity: [0, 1] },
    {
      delay: stagger(0.09, { start: 0.8 }),
      duration: 0.22,
      easing: "ease-out",
    }
  );

  // Atmospheric blobs float via transform-only WAAPI (GPU compositor thread)
  animate(
    ".hero-blob-1",
    { transform: ["translate(0, 0)", "translate(70px, -50px)", "translate(-35px, 28px)", "translate(0, 0)"] },
    { duration: 14, repeat: Infinity, easing: "ease-in-out" }
  );
  animate(
    ".hero-blob-2",
    { transform: ["translate(0, 0)", "translate(-60px, 38px)", "translate(30px, -65px)", "translate(0, 0)"] },
    { duration: 18, repeat: Infinity, easing: "ease-in-out" }
  );
  animate(
    ".hero-blob-3",
    { transform: ["translate(0, 0)", "translate(45px, -35px)", "translate(-55px, 50px)", "translate(0, 0)"] },
    { duration: 22, repeat: Infinity, easing: "ease-in-out" }
  );
  animate(
    ".hero-blob-4",
    { transform: ["translate(0, 0)", "translate(40px, -20px)", "translate(-40px, -10px)", "translate(0, 0)"] },
    { duration: 26, repeat: Infinity, easing: "ease-in-out" }
  );
</script>

<style>
  @property --sky-h {
    syntax: '<percentage>';
    initial-value: 70%;
    inherits: false;
  }
  @property --sky-top {
    syntax: '<percentage>';
    initial-value: -15%;
    inherits: false;
  }
  @keyframes sky-breathe {
    from { --sky-h: 70%; --sky-top: -15%; }
    to   { --sky-h: 95%; --sky-top: -4%; }
  }
  @keyframes blob-pulse-1 {
    0%, 100% { opacity: 0.50; }
    50%      { opacity: 0.25; }
  }
  @keyframes blob-pulse-2 {
    0%, 100% { opacity: 0.42; }
    50%      { opacity: 0.20; }
  }
  @keyframes blob-pulse-3 {
    0%, 100% { opacity: 0.38; }
    50%      { opacity: 0.18; }
  }
  @keyframes blob-pulse-4 {
    0%, 100% { opacity: 0.22; }
    50%      { opacity: 0.10; }
  }
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(64px);
    will-change: transform, opacity;
    z-index: 0;
  }
  .hero-blob-1 {
    width: 520px; height: 520px;
    background: radial-gradient(circle, #cfe7ff 0%, transparent 70%);
    top: -100px; left: -120px;
    animation: blob-pulse-1 7s ease-in-out infinite;
  }
  .hero-blob-2 {
    width: 440px; height: 440px;
    background: radial-gradient(circle, #a8c8e8 0%, transparent 70%);
    top: -30px; right: -100px;
    animation: blob-pulse-2 9s ease-in-out infinite;
    animation-delay: -3s;
  }
  .hero-blob-3 {
    width: 380px; height: 380px;
    background: radial-gradient(circle, #cfe7ff 0%, transparent 70%);
    top: 60px; left: 36%;
    animation: blob-pulse-3 11s ease-in-out infinite;
    animation-delay: -5s;
  }
  .hero-blob-4 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, #daeeff 0%, transparent 70%);
    bottom: -120px; left: calc(50% - 300px);
    animation: blob-pulse-4 13s ease-in-out infinite;
    animation-delay: -7s;
  }
  .hero {
    background:
      radial-gradient(ellipse 110% var(--sky-h) at 50% var(--sky-top), #cfe7ff 0%, #daeeff 20%, transparent 58%),
      #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    position: relative;
    animation: sky-breathe 9s ease-in-out infinite alternate;
  }
  .hero-inner {
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
    padding: 80px var(--space-xl) 56px;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .hero-id {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    text-align: left;
  }
  .hero-photo {
    display: block;
    flex-shrink: 0;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-canvas);
    box-shadow: 0 0 0 1px var(--color-hairline-strong), 0 12px 32px rgba(23, 23, 23, 0.12);
  }
  .hero h1 {
    font-size: 72px;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -2.16px;
    line-height: 1.05;
    margin: 0 0 var(--space-xs);
  }
  .hero-role {
    font-size: 20px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.2px;
    margin: 0;
  }
  .hero-sub {
    font-size: 18px;
    color: var(--color-body);
    line-height: 1.65;
    max-width: 600px;
    margin: 0 auto var(--space-xxl);
  }
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    margin-bottom: var(--space-xxl);
  }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: var(--space-xxs) var(--space-xs); border-radius: var(--radius-md); text-decoration: none; transition: background 0.15s; }
  a.stat:hover { background: var(--color-surface-strong); text-decoration: none; }
  a.stat:hover .stat-l { color: var(--color-ink); }
  .stat-n { font-size: 28px; font-weight: 600; color: var(--color-ink); letter-spacing: -0.84px; line-height: 1; }
  .stat-l { font-size: 13px; color: var(--color-muted); line-height: 1.4; }
  .stat-divider { width: 1px; height: 36px; background: var(--color-hairline-strong); flex-shrink: 0; }
  /* The about page leads, contact follows; GitHub and LinkedIn come last as plain icon buttons. */
  .hero-ctas { display: flex; gap: var(--space-sm); justify-content: center; align-items: center; flex-wrap: wrap; }
  .hero-social { display: flex; gap: var(--space-sm); }
  .btn-primary {
    display: inline-flex; align-items: center;
    background: var(--color-primary); color: var(--color-on-primary);
    font-size: 14px; font-weight: 500; padding: 10px 18px; height: 40px;
    border-radius: var(--radius-md); text-decoration: none; transition: background 0.15s;
  }
  .btn-primary:hover { background: var(--color-primary-active); text-decoration: none; }
  .btn-secondary {
    display: inline-flex; align-items: center;
    background: var(--color-surface-card); color: var(--color-ink);
    border: 1px solid var(--color-hairline-strong);
    font-weight: 500; border-radius: var(--radius-md); text-decoration: none; transition: border-color 0.15s;
  }
  .btn-secondary:hover { border-color: var(--color-ink); text-decoration: none; }
  .btn-hero { gap: var(--space-xs); height: 48px; padding: 0 22px; font-size: 16px; }
  .btn-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px;
    background: var(--color-surface-card); color: var(--color-ink);
    border-radius: var(--radius-md); border: 1px solid var(--color-hairline-strong);
    text-decoration: none; transition: border-color 0.15s, background 0.15s;
  }
  .btn-icon:hover { border-color: var(--color-muted); background: var(--color-canvas-soft); text-decoration: none; }
  .hero-mockup-wrap {
    width: 100%;
    max-width: 880px;
    padding: 0 var(--space-xl);
    position: relative;
    z-index: 1;
  }
  .mockup-window {
    background: #0d0d0d;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
    box-shadow: 0 -8px 40px rgba(0,0,0,0.12);
    border: 1px solid rgba(255,255,255,0.06);
    border-bottom: none;
  }
  .mockup-bar {
    background: #1a1a1a;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .mockup-dots { display: flex; gap: 6px; }
  .dot-r, .dot-y, .dot-g { width: 12px; height: 12px; border-radius: 50%; display: block; }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #ffbd2e; }
  .dot-g { background: #28c840; }
  .mockup-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #555;
    margin: 0 auto;
  }
  .mockup-body {
    padding: 20px 24px 32px;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 13px;
    line-height: 1.75;
  }
  .ml { display: block; color: #e0e0e0; }
  .mo { color: #777; padding-left: 16px; }
  .mt8 { margin-top: 8px; }
  .mp { color: #47c2ff; margin-right: 8px; }
  .mc { color: #e0e0e0; }
  .mc-cursor { color: #47c2ff; animation: blink 1s step-end infinite; }
  .mhi { color: #cfe7ff; }
  .mg { color: #28c840; }
  .mb { color: #47c2ff; }
  .myear { color: #777; }
  /* Personal milestones sit in the same log but read quieter than the career entries. */
  .mlife { color: #8a8a8a; }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (max-width: 768px) {
    .hero h1 { font-size: 52px; letter-spacing: -1.56px; }
    .hero-photo { width: 108px; height: 108px; }
    .hero-id { gap: var(--space-lg); }
    .hero-role { font-size: 18px; }
    .hero-stats { gap: var(--space-lg); }
    .stat-n { font-size: 22px; }
    .hero-blob-1 { width: 312px; height: 312px; filter: blur(40px); }
    .hero-blob-2 { width: 264px; height: 264px; filter: blur(40px); }
    .hero-blob-3 { width: 228px; height: 228px; filter: blur(40px); }
    .hero-blob-4 { width: 360px; height: 360px; filter: blur(40px); }
  }
  @media (max-width: 640px) {
    .hero-inner { padding: 56px var(--space-base) 40px; }
    .hero h1 { font-size: 40px; letter-spacing: -1.2px; }
    .hero-id { flex-direction: column; gap: var(--space-lg); text-align: center; }
    .hero-role { font-size: 17px; }
    .hero-photo { width: 104px; height: 104px; }
    .hero-sub { font-size: 16px; }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-sm);
      align-items: start;
    }
    .stat-n { font-size: 20px; }
    .stat-l { font-size: 12px; }
    .stat-divider { display: none; }
    .hero-ctas { width: 100%; }
    .hero-ctas .btn-hero { flex: 1 1 100%; justify-content: center; white-space: nowrap; }
    .hero-mockup-wrap { padding: 0 var(--space-base); }
    .mockup-body { padding: 14px var(--space-base) 18px; font-size: 11px; }
    .mockup-bar { padding: 10px var(--space-base); }
    .hero-blob { display: none; }
  }
  @media (max-width: 380px) {
    .mockup-body { font-size: 10px; padding: 12px var(--space-sm) 16px; }
  }
</style>
