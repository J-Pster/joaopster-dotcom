---
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';
import { aboutPath } from '../../lib/aboutPath';

interface Props {
  /** "summary": the first paragraph and a link to the about page (home). "full": the whole story and specialties. */
  variant: 'summary' | 'full';
}

const { variant } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const story = t('about.sub').split('\n\n');
const paragraphs = variant === 'summary' ? story.slice(0, 1) : story;

const specialties = [
  { title: t('about.spec.g1.title'), items: t('about.spec.g1.items').split(' | ') },
  { title: t('about.spec.g2.title'), items: t('about.spec.g2.items').split(' | ') },
  { title: t('about.spec.g3.title'), items: t('about.spec.g3.items').split(' | ') },
  { title: t('about.spec.g4.title'), items: t('about.spec.g4.items').split(' | ') },
  { title: t('about.spec.g5.title'), items: t('about.spec.g5.items').split(' | ') },
];
---
<section id="about" class="dark-about">
  <div class="dark-about-inner">
    <div class:list={['da-top', variant === 'summary' && 'da-top--single']}>
      <div class="da-intro">
        <p class="da-label">{t('about.label')}</p>
        <h2 class="da-heading">{t('about.heading1')}<br/>{t('about.heading2')}</h2>
        {paragraphs.map((paragraph) => <p class="da-sub">{paragraph}</p>)}
        {variant === 'summary' && <a href={aboutPath(lang)} class="da-more">{t('about.readMore')} →</a>}
      </div>
      {variant === 'full' && <div id="specialties" class="da-specialties">
        <p class="da-spec-label">{t('about.specialties.label')}</p>
        <div class="da-spec-frame">
          <div class="da-spec-scroll" tabindex="0" aria-label={t('about.specialties.label')}>
            {specialties.map((g) => (
              <div class="da-spec-card">
                <h3>{g.title}</h3>
                <ul>
                  {g.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>}
    </div>
  </div>
</section>

<style>
  .dark-about {
    background: var(--color-surface-dark);
    padding: var(--space-section) var(--space-xl);
  }
  .dark-about-inner { max-width: 1000px; margin: 0 auto; }
  .da-label { font-size: 11px; font-weight: 600; letter-spacing: 0.88px; text-transform: uppercase; color: var(--color-on-dark-soft); margin-bottom: var(--space-lg); }
  .da-heading { font-size: 48px; font-weight: 600; color: var(--color-on-dark); letter-spacing: -1.44px; line-height: 1.1; margin-bottom: var(--space-lg); }
  .da-sub { font-size: 16px; color: var(--color-on-dark-soft); line-height: 1.6; max-width: 480px; margin: 0 0 var(--space-base); }
  .da-sub:last-of-type { margin-bottom: 0; }
  .da-top { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: var(--space-xxl); }
  .da-top--single { grid-template-columns: 1fr; }
  .da-top--single .da-sub { max-width: 640px; }
  .da-more { display: inline-block; margin-top: var(--space-lg); font-size: 14px; font-weight: 500; color: var(--color-on-dark); text-decoration: underline; text-underline-offset: 3px; }
  .da-more:hover { color: var(--color-on-dark-soft); }

  /* The specialties column takes the intro's height; the list scrolls inside it instead of growing the section. */
  .da-specialties { display: flex; flex-direction: column; min-height: 0; }
  .da-spec-label { font-size: 11px; font-weight: 600; letter-spacing: 0.88px; text-transform: uppercase; color: var(--color-on-dark-soft); margin-bottom: var(--space-lg); }
  .da-spec-frame { position: relative; flex: 1; min-height: 480px; }
  .da-spec-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-base);
    padding: 0 var(--space-xs) var(--space-xxl) 0;
    /* Default chaining: once the list hits its top or bottom, the same gesture keeps scrolling the page. */
    overscroll-behavior-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
    /* Fades the bottom edge so a half-visible card reads as "there is more below". */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 64px), transparent);
  }
  .da-spec-scroll:focus-visible { outline: 2px solid var(--color-on-dark); outline-offset: 4px; border-radius: var(--radius-lg); }
  .da-spec-card { flex-shrink: 0; background: var(--color-surface-dark-elevated); border: 1px solid rgba(255,255,255,0.07); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .da-spec-card h3 { font-size: 16px; font-weight: 600; color: var(--color-on-dark); margin: 0 0 var(--space-base); line-height: 1.4; letter-spacing: 0; }
  .da-spec-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .da-spec-card li { position: relative; padding-left: 18px; font-size: 14px; color: var(--color-on-dark-soft); line-height: 1.5; }
  .da-spec-card li::before { content: ''; position: absolute; left: 0; top: 9px; width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,0.28); }

  @media (max-width: 860px) {
    .da-top { grid-template-columns: 1fr; gap: var(--space-xxl); }
    /* Stacked under the intro there is no row height to borrow, so cap the list instead. */
    .da-spec-frame { flex: none; height: 520px; min-height: 0; }
  }
  @media (max-width: 768px) { .da-heading { font-size: 36px; } }
  @media (max-width: 640px) {
    .dark-about { padding: var(--space-section) var(--space-base); }
    .da-heading { font-size: 28px; }
    .da-spec-card { padding: var(--space-base); }
  }
</style>
