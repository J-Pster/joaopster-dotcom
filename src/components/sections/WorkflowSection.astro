---
import type { WakatimeData } from '../../lib/getWakatimeData';
import { ACTIVITY_LEVELS, activityCellTitle, buildActivityGrid } from '../../lib/wakatimeActivity';

interface LatestPostCard {
  pill: string;
  title: string;
  dateText: string;
  excerpt: string;
  href: string;
  readMore: string;
  readTimeText: string;
}

interface Props {
  label: string;
  /** Intl locale used to format the live-refreshed addendum hours. */
  locale?: string;
  /** Untranslated addendum base, so the client can rebuild it with fresh hours. */
  addendumBase?: string;
  heading: string;
  citation?: string;
  body: string;
  addendum?: string;
  cta?: { text: string; href: string };
  variant: 'write' | 'opensource';
  flip?: boolean;
  wakatimeData?: WakatimeData;
  latestPost?: LatestPostCard;
}

const { label, locale, addendumBase, heading, citation, body, addendum, cta, variant, flip = false, wakatimeData, latestPost } = Astro.props;
const activityGrid = wakatimeData && locale ? buildActivityGrid(wakatimeData.activity, locale) : undefined;
---

<section id={variant === 'opensource' ? 'opensource' : 'writing'} class:list={['workflow-section', flip && 'workflow-section--flip', Astro.slots.has('default') && 'workflow-section--extended']}>
  <div class="workflow-inner">
    <div class="workflow-text">
      <span class="workflow-label">{label}</span>
      <h2 class="workflow-heading">{heading}</h2>
      {citation && <cite class="workflow-cite">{citation}</cite>}
      <p class="workflow-body">{body}</p>
      {addendum && <p class="workflow-addendum" data-waka-addendum={addendumBase} data-waka-locale={locale}>{addendum}</p>}
      {cta && (
        <a class="workflow-cta" href={cta.href}>{cta.text} →</a>
      )}
    </div>

    <div class="workflow-card">
      {variant === 'write' && latestPost && (
        <a class="card-write" href={latestPost.href}>
          <span class="write-pill">{latestPost.pill}</span>
          <h3 class="write-post-title">{latestPost.title}</h3>
          <span class="write-post-date">{latestPost.dateText}</span>
          <div class="write-divider"></div>
          <div class="write-preview-wrap">
            <p class="write-preview">{latestPost.excerpt}</p>
            <div class="write-fade"></div>
          </div>
          <div class="write-footer">
            <span class="write-read-more">{latestPost.readMore}</span>
            <span class="write-read-time">{latestPost.readTimeText}</span>
          </div>
        </a>
      )}

      {variant === 'opensource' && (
        <div class="card-wakatime">
          <div class="waka-header">
            <div class="waka-brand-row">
              <span class="waka-dot"></span>
              <span class="waka-brand">WakaTime</span>
            </div>
            <span class="waka-user">@JoaoPster</span>
          </div>

          <div class="waka-metrics">
            <div class="waka-metric">
              <span class="waka-metric-value" data-waka="total">{wakatimeData?.totalText ?? '---'}</span>
              <span class="waka-metric-label">Total coded</span>
            </div>
            <div class="waka-metric-sep"></div>
            <div class="waka-metric">
              <span class="waka-metric-value" data-waka="daily">{wakatimeData?.dailyAvgText ?? '---'}</span>
              <span class="waka-metric-label">Daily avg</span>
            </div>
          </div>

          <div class="waka-divider"></div>

          <div class="waka-activity" data-waka-locale={locale}>
            <span class="waka-metric-label">Activity last year</span>
            <div class="waka-activity-body" data-waka="activity" style={`--weeks:${activityGrid?.weeks.length ?? 53}`}>
              <div class="waka-activity-months">
                {activityGrid?.months.map((month) => (
                  <span style={`grid-column:${month.week + 1}`}>{month.label}</span>
                ))}
              </div>
              <div class="waka-activity-grid">
                {activityGrid?.weeks.flat().map((cell) =>
                  cell ? (
                    <span class="waka-cell" data-level={cell.level} title={activityCellTitle(cell, locale!)}></span>
                  ) : (
                    <span class="waka-cell waka-cell--blank"></span>
                  ),
                )}
              </div>
            </div>
            <div class="waka-activity-legend" aria-hidden="true">
              <span>Less</span>
              {ACTIVITY_LEVELS.map((level) => <span class="waka-cell" data-level={level}></span>)}
              <span>More</span>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
  {Astro.slots.has('default') && <div class="workflow-extra"><slot /></div>}
</section>

<style>
  .workflow-section {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }

  .workflow-section--flip {
    background: var(--color-canvas-soft);
  }

  .workflow-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-section) var(--space-xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* Text always order 1, card order 2 */
  .workflow-text {
    order: 1;
  }

  .workflow-card {
    order: 2;
  }

  /* flip: text goes to right, card to left */
  .workflow-section--flip .workflow-text {
    order: 2;
  }

  .workflow-section--flip .workflow-card {
    order: 1;
  }

  /* --- Text column --- */
  .workflow-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.88px;
    color: var(--color-muted);
    margin-bottom: var(--space-base);
  }

  .workflow-heading {
    font-size: 36px;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -1.08px;
    line-height: 1.15;
    margin: 0 0 var(--space-base) 0;
  }

  .workflow-cite {
    display: block;
    font-size: 13px;
    font-style: normal;
    color: var(--color-muted-soft);
    margin: -8px 0 18px 0;
  }

  .workflow-body {
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.7;
    margin: 0 0 12px 0;
  }

  .workflow-addendum {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 28px 0;
    padding: 10px 14px;
    border-left: 2px solid var(--color-hairline-strong);
  }

  .workflow-cta {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-link);
    text-decoration: none;
  }

  .workflow-cta:hover {
    text-decoration: underline;
  }

  /* --- Dark card --- */
  .workflow-card {
    background: var(--color-surface-dark);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-xl);
    padding: 28px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Extra content below the two columns (more posts, newsletter) */
  .workflow-section--extended .workflow-inner {
    padding-bottom: var(--space-xxl);
  }

  .workflow-extra {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-section);
  }

  /* Components ship an inline <script> after their markup, so skip it when finding the last block. */
  .workflow-extra > :global(:nth-last-child(1 of :not(script))) {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .workflow-extra {
      padding: 0 var(--space-base) 64px;
    }
  }

  /* === WRITE variant === */
  .card-write {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    color: inherit;
  }

  .write-pill {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.88px;
    color: var(--color-on-dark-soft);
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 3px 10px;
    margin-bottom: 12px;
    width: fit-content;
  }

  .write-post-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-on-dark);
    margin: 0 0 6px 0;
    line-height: 1.4;
  }

  .write-post-date {
    font-size: 12px;
    color: var(--color-on-dark-soft);
    margin-bottom: 14px;
    display: block;
  }

  .write-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin-bottom: 14px;
  }

  .write-preview-wrap {
    position: relative;
    margin-bottom: 16px;
  }

  .write-preview {
    font-size: 13px;
    color: var(--color-on-dark-soft);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .write-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 28px;
    background: linear-gradient(to bottom, transparent, var(--color-surface-dark));
    pointer-events: none;
  }

  .write-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .write-read-more {
    font-size: 13px;
    font-weight: 500;
    color: #47c2ff;
    text-decoration: none;
  }

  .card-write:hover .write-read-more {
    text-decoration: underline;
  }

  .write-read-time {
    font-size: 12px;
    color: var(--color-on-dark-soft);
  }

  /* === WAKATIME card (opensource variant) === */
  .card-wakatime {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .waka-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .waka-brand-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .waka-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #28c840;
    flex-shrink: 0;
  }

  .waka-brand {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-on-dark);
    font-family: 'JetBrains Mono', monospace;
  }

  .waka-user {
    font-size: 12px;
    color: var(--color-on-dark-soft);
    font-family: 'JetBrains Mono', monospace;
  }

  .waka-metrics {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .waka-metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .waka-metric-value {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-on-dark);
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: -0.5px;
  }

  .waka-metric-label {
    font-size: 10px;
    color: var(--color-on-dark-soft);
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }

  .waka-metric-sep {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 20px;
    flex-shrink: 0;
  }

  .waka-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Activity heatmap: one column per week, Sunday on top. */
  .waka-activity {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Columns are fractions of the card width, so the grid shrinks instead of scrolling. */
  .waka-activity-body {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .waka-activity-months,
  .waka-activity-grid {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    column-gap: 2px;
  }

  .waka-activity-months span {
    font-size: 10px;
    color: var(--color-on-dark-soft);
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
  }

  .waka-activity-grid {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: 2px;
  }

  .waka-cell {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.06);
  }

  .waka-cell--blank {
    background: transparent;
  }

  .waka-cell[data-level='1'] { background: rgba(71, 194, 255, 0.25); }
  .waka-cell[data-level='2'] { background: rgba(71, 194, 255, 0.45); }
  .waka-cell[data-level='3'] { background: rgba(71, 194, 255, 0.7); }
  .waka-cell[data-level='4'] { background: #47c2ff; }

  .waka-activity-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    font-size: 10px;
    color: var(--color-on-dark-soft);
    font-family: 'JetBrains Mono', monospace;
  }

  .waka-activity-legend .waka-cell {
    width: 9px;
  }

  .waka-activity-legend span:first-child {
    margin-right: 3px;
  }

  .waka-activity-legend span:last-child {
    margin-left: 3px;
  }

  /* === Responsive === */
  @media (max-width: 900px) {
    .workflow-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 64px var(--space-base);
    }

    /* Text always first on mobile regardless of flip */
    .workflow-text {
      order: 1 !important;
    }

    .workflow-card {
      order: 2 !important;
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .workflow-inner {
      gap: var(--space-xl);
      padding: var(--space-section) var(--space-base);
    }

    .workflow-card {
      padding: var(--space-base);
      min-height: auto;
    }

    .waka-metric-label {
      font-size: 11px;
    }

    .waka-brand,
    .waka-user {
      font-size: 12px;
    }
  }
</style>

<script>
  import { buildAddendum, type WakatimeData } from '../../lib/getWakatimeData';
  import { activityCellTitle, buildActivityGrid, type ActivityDay } from '../../lib/wakatimeActivity';

  // Mirrors the Astro markup for the activity grid, so live data redraws it in place.
  function renderActivity(body: HTMLElement, activity: readonly ActivityDay[], locale: string): void {
    const grid = buildActivityGrid(activity, locale);
    body.style.setProperty('--weeks', String(grid.weeks.length));
    const months = grid.months.map((month) => {
      const label = document.createElement('span');
      label.style.gridColumn = String(month.week + 1);
      label.textContent = month.label;
      return label;
    });
    const cells = grid.weeks.flat().map((cell) => {
      const square = document.createElement('span');
      square.className = cell ? 'waka-cell' : 'waka-cell waka-cell--blank';
      if (cell) {
        square.dataset.level = String(cell.level);
        square.title = activityCellTitle(cell, locale);
      }
      return square;
    });
    body.querySelector('.waka-activity-months')!.replaceChildren(...months);
    body.querySelector('.waka-activity-grid')!.replaceChildren(...cells);
  }

  // The HTML ships a build-time snapshot; replace it with live numbers.
  async function refreshWakatime(): Promise<void> {
    const res = await fetch('/api/wakatime');
    if (!res.ok) throw new Error(`/api/wakatime responded ${res.status}`);
    const data = (await res.json()) as WakatimeData;

    document.querySelectorAll('[data-waka="total"]').forEach(el => { el.textContent = data.totalText; });
    document.querySelectorAll('[data-waka="daily"]').forEach(el => { el.textContent = data.dailyAvgText; });

    document.querySelectorAll<HTMLElement>('[data-waka-addendum]').forEach(el => {
      el.textContent = buildAddendum(el.dataset.wakaAddendum!, data, el.dataset.wakaLocale!);
    });

    document.querySelectorAll<HTMLElement>('[data-waka="activity"]').forEach(body => {
      const locale = body.closest<HTMLElement>('[data-waka-locale]')!.dataset.wakaLocale!;
      renderActivity(body, data.activity, locale);
    });
  }

  if (document.querySelector('[data-waka]')) {
    refreshWakatime().catch(err => console.warn('[wakatime] live refresh failed, keeping build snapshot:', err));
  }
</script>
