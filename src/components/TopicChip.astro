---
// A post's topic: its label on a light tint of the topic's color, with a dot of that color.
import type { Lang } from '../i18n/ui';
import { topicColor, topicLabel, topicTint, type TopicId } from '../lib/blog/topics';

interface Props {
  topic: TopicId;
  lang: Lang;
}

const { topic, lang } = Astro.props;
---

<span class="topic-chip" style={`--topic: ${topicColor(topic)}; --topic-tint: ${topicTint(topic)}`}>{topicLabel(topic, lang)}</span>

<style>
  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--topic-tint);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .topic-chip::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--topic);
  }
</style>
