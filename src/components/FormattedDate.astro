---
// A date in the page's language: "26 de nov. de 2026" in Portuguese, "Nov 26, 2026" in English.
// Lists grouped by year pass withYear={false} and get "26 de nov." / "Nov 26".
import { DATE_LOCALES, defaultLang, type Lang } from '../i18n/ui';

interface Props {
	date: Date;
	withYear?: boolean;
}

const { date, withYear = true } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
---

<time datetime={date.toISOString()} style="font-size: 13px; color: var(--color-muted); line-height: 1.4;">
	{
		date.toLocaleDateString(DATE_LOCALES[lang], {
			...(withYear ? { year: 'numeric' } : {}),
			month: 'short',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
