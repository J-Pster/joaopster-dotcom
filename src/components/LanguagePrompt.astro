---
// Asks the reader's language when the head script of BaseHead found no hint at all
// (i18n/languagePreference.ts). In English, with English picked, and each option named in its own
// language next to its flag, so a reader who reads none of them still finds theirs.
// It lives in a <template> because BaseHead renders inside <head>; the script moves it into the body.
import LanguageFlag from './LanguageFlag.astro';
import { languages, type Lang } from '../i18n/ui';

interface Props {
  /** The language of this page. */
  pageLang: Lang;
  /** Where each language opens this page, or null when the page exists in one language only. */
  targets: Readonly<Partial<Record<Lang, string>>> | null;
}

const { pageLang, targets } = Astro.props;
const PRESELECTED: Lang = 'en';
---

<template id="language-prompt" data-page-lang={pageLang} data-targets={JSON.stringify(targets)}>
  <dialog class="lang-prompt" lang="en" aria-labelledby="lang-prompt-title">
    <form method="dialog" class="lang-prompt-form">
      <button class="lang-prompt-close" type="submit" value="dismiss" aria-label="Close">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <h2 class="lang-prompt-title" id="lang-prompt-title">Which language do you speak?</h2>
      <fieldset class="lang-prompt-options">
        <legend class="sr-only">Language</legend>
        {(Object.entries(languages) as [Lang, string][]).map(([lang, name]) => (
          <label class="lang-prompt-option">
            <input type="radio" name="language" value={lang} checked={lang === PRESELECTED} />
            <LanguageFlag lang={lang} width={30} />
            <span class="lang-prompt-name" lang={lang}>{name}</span>
          </label>
        ))}
      </fieldset>
      <button class="lang-prompt-continue" type="submit" value="continue" autofocus>Continue</button>
    </form>
  </dialog>
</template>

<style>
  .lang-prompt {
    width: min(400px, calc(100vw - 2 * var(--space-base)));
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface-card);
    color: var(--color-ink);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
  }
  .lang-prompt::backdrop {
    background: rgba(23, 23, 23, 0.45);
  }

  .lang-prompt-form {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
  }

  .lang-prompt-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  .lang-prompt-close:hover { background: var(--color-surface-strong); color: var(--color-ink); }

  .lang-prompt-title {
    margin: 0 0 var(--space-lg);
    padding-right: var(--space-xl);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.5px;
  }

  .lang-prompt-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0 0 var(--space-lg);
    padding: 0;
    border: none;
  }

  .lang-prompt-option {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 52px;
    padding: 0 var(--space-base);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    transition: background 0.12s, border-color 0.12s;
  }
  .lang-prompt-option:hover { background: var(--color-canvas-soft); }
  .lang-prompt-option:has(input:checked) {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .lang-prompt-option:has(input:focus-visible) {
    outline: 2px solid var(--color-text-link);
    outline-offset: 2px;
  }

  .lang-prompt-option input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--color-primary);
  }

  .lang-prompt-continue {
    height: 40px;
    padding: 0 18px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .lang-prompt-continue:active { background: var(--color-primary-active); }
  .lang-prompt-continue:focus-visible {
    outline: 2px solid var(--color-text-link);
    outline-offset: 2px;
  }
</style>

<script>
  import { isLang } from '../i18n/switchLocale';
  import { PROMPT_DISMISSED_KEY, rememberLanguage } from '../i18n/languagePreference';

  function openPrompt(template: HTMLTemplateElement): void {
    const pageLang = template.dataset.pageLang;
    if (!isLang(pageLang)) throw new Error(`Language prompt without a page language: ${pageLang}`);
    const targets = JSON.parse(template.dataset.targets ?? 'null') as Partial<Record<string, string>> | null;

    const dialog = template.content.firstElementChild?.cloneNode(true);
    if (!(dialog instanceof HTMLDialogElement)) throw new Error('Language prompt template holds no dialog');
    document.body.append(dialog);

    // Continue saves the picked language; the close button and Esc only hide the prompt for this tab.
    dialog.addEventListener('close', () => {
      if (dialog.returnValue !== 'continue') {
        sessionStorage.setItem(PROMPT_DISMISSED_KEY, '1');
        dialog.remove();
        return;
      }
      const picked = dialog.querySelector<HTMLInputElement>('input[name="language"]:checked')?.value;
      if (!isLang(picked)) throw new Error(`Language prompt sent no language: ${picked}`);
      rememberLanguage(picked);
      const target = targets?.[picked];
      if (picked !== pageLang && target) {
        window.location.href = target + window.location.search + window.location.hash;
        return;
      }
      dialog.remove();
    });

    dialog.showModal();
  }

  const template = document.querySelector<HTMLTemplateElement>('#language-prompt');
  if (!template) throw new Error('BaseHead renders the language prompt on every page');
  // The head script only asks when localStorage works, and browsers block localStorage and sessionStorage together.
  if (document.documentElement.dataset.languagePrompt === 'ask' && sessionStorage.getItem(PROMPT_DISMISSED_KEY) !== '1') {
    openPrompt(template);
  }
</script>
