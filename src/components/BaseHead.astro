---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
// Self-hosted fonts (latin subset): only the weights the site uses.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import type { ImageMetadata } from 'astro';
import { SITE_NAME } from '../consts';
import { useTranslations, type Lang } from '../i18n/ui';
import profilePhoto from '../assets/profile-photo.png';
import { siteOgImage } from '../lib/og/siteCards';

interface Props {
	title: string;
	description: string;
	/** Share image; pages without their own use the home card of their language. */
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	/**
	 * Language versions of the page, for hreflang and the language switcher. "auto": the same path
	 * under each language prefix. "none": the page exists in one language only (a course note).
	 * A map: pages whose path differs per language (the courses section).
	 */
	alternates?: 'auto' | 'none' | Readonly<Record<Lang, string>>;
	/** "noindex": thin pages that stay reachable by link but out of search results (glossary terms). */
	indexing?: 'index' | 'noindex';
}

const currentLang = (Astro.currentLocale ?? 'pt') as Lang;
const { title, description, image = siteOgImage(currentLang, 'home'), type = 'website', alternates = 'auto', indexing = 'index' } = Astro.props;
const robots = indexing === 'index' ? 'index, follow, max-image-preview:large' : 'noindex, follow';

const site = Astro.site ?? new URL('https://joaopster.com');
const canonicalURL = new URL(Astro.url.pathname, site);

// Cloudflare Web Analytics beacon (token is public; set via build env var)
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
const imageURL = new URL(typeof image === 'string' ? image : image.src, site);

const localeMap: Record<string, string> = { pt: 'pt_BR', en: 'en_US', es: 'es_ES' };
const ogLocale = localeMap[currentLang] ?? 'pt_BR';
const altLocales = Object.entries(localeMap).filter(([code]) => code !== currentLang);

// Build the equivalent path in each locale for hreflang alternates.
const path = Astro.url.pathname;
let basePath = path;
for (const l of ['en', 'es']) {
	if (path === `/${l}`) { basePath = '/'; break; }
	if (path.startsWith(`/${l}/`)) { basePath = path.slice(l.length + 1); break; }
}
const localizedURL = (l: Lang) =>
	typeof alternates === 'object'
		? new URL(alternates[l], site).href
		: new URL(l === 'pt' ? basePath : `/${l}${basePath === '/' ? '' : basePath}`, site).href;

// The feed of the current language (src/pages/rss.xml.js, en/rss.xml.js, es/rss.xml.js).
const feedPath = currentLang === 'pt' ? '/rss.xml' : `/${currentLang}/rss.xml`;

// Entities are linked by @id: the blog posts name this person as author and publisher.
const PERSON_ID = new URL('/#person', site).href;
const WEBSITE_ID = new URL('/#website', site).href;

const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': PERSON_ID,
	name: 'João Pster',
	// Legal name, in full and in the short form some documents use, so searches for either find the site.
	alternateName: ['João Pedro Viana Freitas', 'João Pedro Viana'],
	url: new URL('/sobre/', site).href,
	// The same role as the hero and the page titles, so every source describes the person the same way.
	jobTitle: useTranslations(currentLang)('hero.role'),
	image: new URL(profilePhoto.src, site).href,
	knowsAbout: ['TypeScript', 'Node.js', 'NestJS', 'Angular', 'React', 'PostgreSQL', 'Amazon Web Services', 'Infrastructure as code', 'Software architecture'],
	alumniOf: { '@type': 'EducationalOrganization', name: 'Trybe', url: 'https://www.betrybe.com/' },
	sameAs: [
		'https://github.com/J-Pster',
		'https://www.linkedin.com/in/joaopster/',
		'https://x.com/JoaoPster',
		'https://wakatime.com/@JoaoPster',
		'https://www.reddit.com/user/Joao-Pster/',
	],
};
const siteLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': WEBSITE_ID,
	name: SITE_NAME,
	url: site.href,
	publisher: { '@id': PERSON_ID },
	author: { '@id': PERSON_ID },
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_NAME}
	href={new URL(feedPath, site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content="João Pster" />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#ffffff" />

<!-- Canonical + language alternates -->
<link rel="canonical" href={canonicalURL} />
{alternates !== 'none' && (
	<>
		<link rel="alternate" hreflang="pt-BR" href={localizedURL('pt')} />
		<link rel="alternate" hreflang="en" href={localizedURL('en')} />
		<link rel="alternate" hreflang="es" href={localizedURL('es')} />
		<link rel="alternate" hreflang="x-default" href={localizedURL('pt')} />
	</>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="João Pster" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} · joaopster.com`} />
<meta property="og:locale" content={ogLocale} />
{altLocales.map(([, locale]) => <meta property="og:locale:alternate" content={locale} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
<meta property="twitter:image:alt" content={`${title} · joaopster.com`} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
<script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

<!-- Cloudflare Web Analytics -->
{cfBeaconToken && (
	<script
		is:inline
		defer
		src="https://static.cloudflareinsights.com/beacon.min.js"
		data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
	></script>
)}
