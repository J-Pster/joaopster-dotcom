---
// ARCHIVED on 2026-11-26: the "Como eu entrego" section, removed from the home page.
// Nothing imports this file. To bring it back, render <DeliverySection /> after
// <FeaturesGridSection /> in src/pages/index.astro, en/index.astro and es/index.astro.
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<section id="deliver" class="workflow-section">
  <div class="workflow-inner">
    <div class="workflow-text">
      <span class="workflow-label">{t('workflow.build.label')}</span>
      <h2 class="workflow-heading">{t('workflow.build.heading')}</h2>
      <p class="workflow-body">{t('workflow.build.body')}</p>
      <a class="workflow-cta" href="#projects">{t('workflow.build.cta')} →</a>
    </div>

    <div class="workflow-card">
      <div class="card-build">
        <div class="build-titlebar">
          <span class="build-title">Production deploy</span>
          <span class="build-dot"></span>
        </div>
        <div class="build-rows">
          <div class="build-row">
            <span class="build-icon">✓</span>
            <span class="build-label">TypeScript check</span>
            <span class="build-badge build-badge--passed">Passed</span>
          </div>
          <div class="build-row">
            <span class="build-icon">✓</span>
            <span class="build-label">Unit tests (47)</span>
            <span class="build-badge build-badge--passed">Passed</span>
          </div>
          <div class="build-row">
            <span class="build-icon">✓</span>
            <span class="build-label">Documentation</span>
            <span class="build-badge build-badge--metric">13 docs</span>
          </div>
          <div class="build-row">
            <span class="build-icon">✓</span>
            <span class="build-label">Build complete</span>
            <span class="build-badge build-badge--metric">1.2s</span>
          </div>
          <div class="build-row">
            <span class="build-icon">✓</span>
            <span class="build-label">Deployed</span>
            <span class="build-badge build-badge--metric">Live</span>
          </div>
        </div>
        <div class="build-url">https://joaopster.com</div>
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-section {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }

  .workflow-section--flip {
    background: var(--color-canvas-soft);
  }

  .workflow-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-section) var(--space-xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* Text always order 1, card order 2 */
  .workflow-text {
    order: 1;
  }

  .workflow-card {
    order: 2;
  }

  /* flip: text goes to right, card to left */
  .workflow-section--flip .workflow-text {
    order: 2;
  }

  .workflow-section--flip .workflow-card {
    order: 1;
  }

  /* --- Text column --- */
  .workflow-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.88px;
    color: var(--color-muted);
    margin-bottom: var(--space-base);
  }

  .workflow-heading {
    font-size: 36px;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -1.08px;
    line-height: 1.15;
    margin: 0 0 var(--space-base) 0;
  }

  .workflow-cite {
    display: block;
    font-size: 13px;
    font-style: normal;
    color: var(--color-muted-soft);
    margin: -8px 0 18px 0;
  }

  .workflow-body {
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.7;
    margin: 0 0 12px 0;
  }

  .workflow-addendum {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 28px 0;
    padding: 10px 14px;
    border-left: 2px solid var(--color-hairline-strong);
  }

  .workflow-cta {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-link);
    text-decoration: none;
  }

  .workflow-cta:hover {
    text-decoration: underline;
  }

  /* --- Dark card --- */
  .workflow-card {
    background: var(--color-surface-dark);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-xl);
    padding: 28px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* === BUILD variant === */
  .card-build {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-radius: calc(var(--radius-xl) - 4px);
    overflow: hidden;
  }

  .build-titlebar {
    background: var(--color-surface-dark-elevated);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: calc(var(--radius-xl) - 4px) calc(var(--radius-xl) - 4px) 0 0;
  }

  .build-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-on-dark);
    font-family: 'JetBrains Mono', monospace;
  }

  .build-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #28c840;
  }

  .build-rows {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 8px 0;
  }

  .build-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
  }

  .build-icon {
    font-size: 12px;
    color: #28c840;
    width: 16px;
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
  }

  .build-label {
    font-size: 13px;
    color: var(--color-on-dark-soft);
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
  }

  .build-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9999px;
    white-space: nowrap;
    font-family: 'JetBrains Mono', monospace;
  }

  .build-badge--passed {
    background: rgba(40, 200, 64, 0.15);
    color: #28c840;
  }

  .build-badge--metric {
    background: rgba(71, 194, 255, 0.15);
    color: #47c2ff;
  }

  .build-url {
    padding: 10px 16px 4px;
    font-size: 12px;
    font-family: 'JetBrains Mono', monospace;
    color: #47c2ff;
  }
  /* === Responsive === */
  @media (max-width: 900px) {
    .workflow-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 64px var(--space-base);
    }

    /* Text always first on mobile regardless of flip */
    .workflow-text {
      order: 1 !important;
    }

    .workflow-card {
      order: 2 !important;
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .workflow-inner {
      gap: var(--space-xl);
      padding: var(--space-section) var(--space-base);
    }

    .workflow-card {
      padding: var(--space-base);
      min-height: auto;
    }

    .waka-lang-name,
    .waka-lang-pct,
    .waka-metric-label {
      font-size: 11px;
    }

    .waka-brand,
    .waka-user {
      font-size: 12px;
    }
  }
</style>
