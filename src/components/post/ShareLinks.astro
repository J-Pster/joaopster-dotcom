---
// Share the current post: copy its link or open the network's own share page (no third-party scripts).
// "buttons": labelled buttons at the end of the post. "icons": one compact row for the side column.
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

interface Props {
  title: string;
  url: string;
  variant: 'buttons' | 'icons';
}

const { title, url, variant } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? defaultLang) as Lang);
const enc = encodeURIComponent;
const networks = [
  {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    name: 'X',
    href: `https://x.com/intent/post?text=${enc(title)}&url=${enc(url)}`,
    icon: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  },
  {
    name: 'Bluesky',
    href: `https://bsky.app/intent/compose?text=${enc(`${title} ${url}`)}`,
    icon: 'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z',
  },
];
const iconOnly = variant === 'icons';
---

<div class={`share share--${variant}`} role="group" aria-label={t('post.share')}>
  <p class="share-title">{t('post.share')}</p>
  <div class="share-actions">
    <button
      type="button"
      class="share-btn share-copy"
      data-url={url}
      data-copied={t('post.linkCopied')}
      title={iconOnly ? t('post.copyLink') : undefined}
    >
      {iconOnly && (
        <svg class="share-icon share-icon--idle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        <svg class="share-icon share-icon--done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      )}
      <span class="share-copy-label" aria-live="polite">{t('post.copyLink')}</span>
    </button>
    {networks.map((n) => (
      <a
        class="share-btn"
        href={n.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${t('post.share')}: ${n.name}`}
        title={iconOnly ? n.name : undefined}
      >
        {iconOnly ? (
          <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={n.icon} /></svg>
        ) : n.name}
      </a>
    ))}
  </div>
</div>

<style>
  .share-title {
    margin: 0 0 var(--space-xs);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.88px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .share-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .share-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 12px;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-md);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .share-btn:hover { border-color: var(--color-ink); text-decoration: none; }

  .share--icons .share-actions { flex-wrap: nowrap; }
  .share--icons .share-btn { width: 32px; padding: 0; color: var(--color-body); }
  .share--icons .share-btn:hover { color: var(--color-ink); }
  .share-icon { width: 15px; height: 15px; }
  .share-icon--done { display: none; color: var(--color-ink); }
  .share-copy.is-copied .share-icon--idle { display: none; }
  .share-copy.is-copied .share-icon--done { display: block; }
  /* Icon row: the label stays for screen readers (and announces "copied") but is not drawn. */
  .share--icons .share-copy-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((button) => {
    const label = button.querySelector<HTMLElement>('.share-copy-label');
    if (!label) throw new Error('Share copy button is missing its label');
    const idleLabel = label.textContent ?? '';
    button.addEventListener('click', async () => {
      const { url, copied } = button.dataset;
      if (!url || !copied) throw new Error('Share button is missing its url or copied label');
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // Clipboard blocked (in-app webviews, denied permission): hand the link over to copy by hand.
        window.prompt(idleLabel, url);
        return;
      }
      label.textContent = copied;
      button.classList.add('is-copied');
      setTimeout(() => {
        label.textContent = idleLabel;
        button.classList.remove('is-copied');
      }, 2000);
    });
  });
</script>
