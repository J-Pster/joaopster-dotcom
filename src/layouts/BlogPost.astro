---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import NewsletterModal from '../components/NewsletterModal.astro';
import AuthorBio from '../components/post/AuthorBio.astro';
import RelatedPosts from '../components/post/RelatedPosts.astro';
import ShareLinks from '../components/post/ShareLinks.astro';
import TableOfContents from '../components/post/TableOfContents.astro';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';
import { getBlogAlternates } from '../lib/getLatestPost';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime: number;
	ogImage: string;
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, readingTime, ogImage, post, headings } = Astro.props;

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const blogPath = lang === 'pt' ? '/blog' : `/${lang}/blog`;

const site = Astro.site ?? new URL('https://joaopster.com');
const postUrl = new URL(Astro.url.pathname, site).href;
const alternates = await getBlogAlternates(post);
const PERSON_ID = new URL('/#person', site).href;
const imageUrl = new URL(ogImage, site).href;
const blogLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url: postUrl,
	image: imageUrl,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: postUrl,
	inLanguage: lang,
	author: { '@id': PERSON_ID },
	publisher: { '@id': PERSON_ID },
};
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={ogImage} type="article" alternates={alternates} />
    <script type="application/ld+json" set:html={JSON.stringify(blogLd)} />
  </head>
  <body>
    <div class="reading-progress" id="reading-progress"></div>
    <Header autoHide />
    <main class="post-main">
      <div class="post-layout">
      <aside class="post-rail post-rail--toc">
        <div class="post-rail-inner">
          <TableOfContents headings={headings} variant="rail" />
        </div>
      </aside>
      <aside class="post-rail post-rail--actions">
        <div class="post-rail-inner">
          <ShareLinks title={title} url={postUrl} variant="icons" />
          <button type="button" class="rail-newsletter" data-newsletter-open>
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="14" height="11" rx="2" /><path d="M2 7l7 4.5L16 7" />
            </svg>
            {t('newsletter.open')}
          </button>
        </div>
      </aside>
      <div class="post-container">
        <nav class="post-breadcrumb">
          <a href={blogPath} class="breadcrumb-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M8.5 2.5L4 7l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {t('post.backToBlog')}
          </a>
        </nav>

        <header class="post-header">
          <div class="post-meta">
            <span class="post-date"><FormattedDate date={pubDate} /></span>
            <span class="post-readtime">{readingTime} {t('post.minRead')}</span>
            {updatedDate && (
              <span class="post-updated">{t('post.updated')} <FormattedDate date={updatedDate} /></span>
            )}
          </div>
          <h1 class="post-title">{title}</h1>
          {description && <p class="post-desc">{description}</p>}
        </header>

        <TableOfContents headings={headings} variant="inline" />

        <div class="prose">
          <slot />
        </div>

        <div class="post-share">
          <ShareLinks title={title} url={postUrl} variant="buttons" />
        </div>

        <AuthorBio />

        <Giscus />

        <RelatedPosts post={post} />

        <div class="post-newsletter">
          <NewsletterSignup />
        </div>

        <footer class="post-footer">
          <div class="post-footer-inner">
            <a href={blogPath} class="back-link">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M8.5 2.5L4 7l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {t('post.allPosts')}
            </a>
            <a href="mailto:joao@joaopster.com" class="reply-link">{t('post.replyEmail')}</a>
          </div>
        </footer>
      </div>
      </div>
    </main>
    <NewsletterModal />
    <Footer />
  </body>
</html>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--color-ink);
    z-index: 200;
    transition: width 80ms linear;
  }
  .post-main { padding: var(--space-xxl) var(--space-base) var(--space-section); }
  .post-container { max-width: 680px; margin: 0 auto; }
  /* Wide screens: the table of contents gets the whole left rail; share and newsletter sit, compact, on the right. */
  .post-rail { display: none; }
  @media (min-width: 1200px) {
    .post-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 680px) minmax(0, 1fr);
      column-gap: var(--space-xxl);
    }
    .post-rail { display: block; grid-row: 1; width: 100%; max-width: 240px; }
    .post-rail--toc { grid-column: 1; justify-self: end; }
    .post-rail--actions { grid-column: 3; justify-self: start; max-width: 220px; }
    .post-rail-inner {
      position: sticky;
      top: 96px;
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
      max-height: calc(100dvh - 112px);
      transition: top 0.25s ease, max-height 0.25s ease;
    }
    /* The header slides away while reading: the rails move up into its space. */
    :global(html.header-hidden) .post-rail-inner { top: 32px; max-height: calc(100dvh - 48px); }
    /* Taller than the viewport, the table of contents scrolls inside its rail. */
    .post-rail-inner > :global(.toc--rail) { flex: 1 1 auto; min-height: 0; }
    /* The right rail already has share and newsletter: no second copy at the end of the post. */
    .post-share,
    .post-newsletter { display: none; }
    .post-container { grid-column: 2; grid-row: 1; width: 100%; }
    .post-container :global(.toc--inline) { display: none; }
  }
  .rail-newsletter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    min-height: 40px;
    padding: var(--space-xs) var(--space-sm);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    text-align: left;
    color: var(--color-ink);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .rail-newsletter:hover { border-color: var(--color-ink); }
  .rail-newsletter svg { flex: none; }
  .post-share { margin-top: var(--space-xxl); padding-top: var(--space-xl); border-top: 1px solid var(--color-hairline); }
  .post-breadcrumb { margin-bottom: var(--space-xl); }
  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .breadcrumb-link:hover { color: var(--color-ink); text-decoration: none; }
  .post-header {
    margin-bottom: var(--space-xxl);
    padding-bottom: var(--space-xxl);
    border-bottom: 1px solid var(--color-hairline);
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .post-date {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-muted);
    background: var(--color-surface-strong);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }
  .post-updated { font-size: 12px; color: var(--color-muted); font-style: italic; }
  .post-readtime { font-size: 13px; font-weight: 500; color: var(--color-muted); }
  .post-readtime::before {
    content: '·';
    margin-right: var(--space-md);
    color: var(--color-muted-soft);
  }
  .post-title {
    font-size: 36px;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -1.08px;
    line-height: 1.15;
    margin: 0 0 var(--space-md);
  }
  .post-desc { font-size: 17px; color: var(--color-body); line-height: 1.65; margin: 0; }
  .prose { color: var(--color-body); font-size: 16px; line-height: 1.8; }
  .prose :global(p) { margin-bottom: 1.5em; }
  .prose :global(a) { color: var(--color-text-link); }
  .prose :global(a:hover) { text-decoration: underline; }
  .prose :global(h2) {
    font-size: 26px; font-weight: 600; color: var(--color-ink);
    letter-spacing: -0.6px; margin: 2.5em 0 0.75em; line-height: 1.2;
  }
  .prose :global(h3) {
    font-size: 20px; font-weight: 600; color: var(--color-ink);
    letter-spacing: -0.3px; margin: 2em 0 0.5em; line-height: 1.3;
  }
  .prose :global(strong) { color: var(--color-ink); font-weight: 600; }
  .prose :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    background: var(--color-surface-strong);
    color: var(--color-ink);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }
  .prose :global(pre) {
    background: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: 1.75em 0;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .prose :global(pre code) {
    all: unset;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--color-on-dark);
    line-height: 1.7;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-hairline-strong);
    padding-left: var(--space-lg);
    margin: 1.75em 0;
    color: var(--color-muted);
    font-style: italic;
  }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--space-lg); margin-bottom: 1.5em; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(img) { border-radius: var(--radius-lg); max-width: 100%; height: auto; border: 1px solid var(--color-hairline); }
  .prose :global(h2), .prose :global(h3) { scroll-margin-top: 88px; }
  .prose :global(.heading-anchor) {
    margin-left: 8px;
    color: var(--color-muted-soft);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .prose :global(.heading-anchor)::before { content: '#'; }
  .prose :global(.heading-anchor.is-copied)::before { content: '✓'; }
  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(.heading-anchor.is-copied) { opacity: 1; }
  .prose :global(.heading-anchor:hover) { color: var(--color-ink); text-decoration: none; }
  @media (hover: none) { .prose :global(.heading-anchor) { opacity: 1; } }
  .prose :global(a.external-link)::after {
    content: '↗';
    display: inline-block;
    margin-left: 2px;
    font-size: 0.8em;
    text-decoration: none;
  }
  .prose :global(hr) { border: none; border-top: 1px solid var(--color-hairline); margin: 2.5em 0; }
  .post-footer {
    margin-top: var(--space-xxl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-hairline);
  }
  .post-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .back-link:hover { color: var(--color-ink); text-decoration: none; }
  .reply-link { font-size: 13px; font-weight: 500; color: var(--color-text-link); text-decoration: none; }
  .reply-link:hover { text-decoration: underline; }
  @media (max-width: 768px) {
    .post-title { font-size: 30px; letter-spacing: -0.9px; }
  }

  @media (max-width: 640px) {
    .post-main { padding: var(--space-lg) var(--space-base) var(--space-xxl); }
    .post-title { font-size: 28px; letter-spacing: -0.84px; }
    .post-desc { font-size: 15px; }
    .post-footer-inner { flex-direction: column; align-items: flex-start; gap: var(--space-base); }
  }
</style>

<script>
  const bar = document.getElementById('reading-progress');
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
    if (bar) bar.style.width = `${Math.min(100, pct)}%`;
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });

  // Section anchors (added by rehypePostLinks): jump to the section and copy its link.
  document.querySelectorAll<HTMLAnchorElement>('.prose .heading-anchor').forEach((anchor) => {
    anchor.addEventListener('click', async () => {
      await navigator.clipboard.writeText(anchor.href);
      anchor.classList.add('is-copied');
      setTimeout(() => anchor.classList.remove('is-copied'), 1500);
    });
  });
</script>
