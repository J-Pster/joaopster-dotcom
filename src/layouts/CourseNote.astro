---
// Course reader page: module navigation on the left, the note in the middle, its table of contents
// on the right, then (for lessons) "mark as read" and previous/next, then the notes that link here.
// The page is in the course's language; the interface text comes from lib/courses/i18n.
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/post/TableOfContents.astro';
import CourseSidebar from '../components/courses/CourseSidebar.astro';
import SyncCard from '../components/courses/SyncCard.astro';
import ShortcutsDialog from '../components/courses/ShortcutsDialog.astro';
import ReaderBar from '../components/courses/ReaderBar.astro';
import OfflineCard from '../components/courses/OfflineCard.astro';
import ReaderTools from '../components/courses/ReaderTools.astro';
import ListenButton from '../components/courses/ListenButton.astro';
import ListenPlayer from '../components/courses/ListenPlayer.astro';
import AssistantPanel from '../components/courses/AssistantPanel.astro';
import KeysDialog from '../components/courses/KeysDialog.astro';
import CourseTour from '../components/courses/CourseTour.astro';
import { courseOutlineUrl, coursesHome, glossaryUrl, hasStudyPages, mistakesUrl, reviewUrl, studyIndexUrl, type ExamRules } from '../lib/courses/catalog';
import { courseText } from '../lib/courses/i18n';
import type { Note, Vault } from '../lib/courses/vault';
import { searchText } from '../lib/courses/searchText';
import { shortcutsText } from '../lib/courses/shortcutsText';
import { readingMinutes } from '../lib/courses/readingTime';
import { readerText } from '../lib/courses/readerText';
import { courseJsonLd, jsonLdScript, noteBreadcrumbJsonLd, noteMetaDescription, seoTitle } from '../lib/courses/seo';
import { useTranslations } from '../i18n/ui';
import { assistantText } from '../lib/courses/assistantText';
import { courseOgImage } from '../lib/og/siteCards';
import '../styles/courses.css';
import '../styles/courses-search.css';
import '../styles/courses-study.css';
import '../styles/courses-highlights.css';
import '../styles/courses-assistant.css';
import '../styles/courses-reader.css';
import '../styles/courses-listen.css';
import '../styles/courses-print.css';

interface Props {
  vault: Vault;
  note: Note;
  html: string;
  headings: readonly MarkdownHeading[];
  /** Set on simulated exams: the note's quiz runs as a timed exam. */
  exam?: ExamRules;
  /**
   * "noindex" on glossary terms: thin pages that stay reachable (previews, in-lesson links) but out of search.
   * A course marked noindex in the catalog overrides this for all of its pages.
   */
  indexing?: 'index' | 'noindex';
}

const BACKLINKS_SHOWN = 24;

const { vault, note, html, headings, exam, indexing: pageIndexing = 'index' } = Astro.props;
const indexing = vault.course.indexing === 'noindex' ? 'noindex' : pageIndexing;
const { course } = vault;
const text = courseText(course.lang);
const search = searchText(course.lang);
const shortcuts = shortcutsText(course.lang);
const reader = readerText(course.lang);
const assistant = assistantText(course.lang);
const module = vault.modules.find((m) => m.id === note.moduleId);
const lessonIndex = note.kind === 'lesson' ? vault.lessons.indexOf(note) : -1;
const previous = lessonIndex > 0 ? vault.lessons[lessonIndex - 1] : undefined;
const next = lessonIndex >= 0 ? vault.lessons[lessonIndex + 1] : undefined;

// Lessons and module notes first, then the rest (glossary terms link to each other a lot).
const kindRank = { lesson: 0, module: 1, home: 2, page: 3, glossary: 4 } as const;
const backlinks = [...(vault.backlinks.get(note.id) ?? [])].sort((a, b) => kindRank[a.kind] - kindRank[b.kind]);

const pageTitle = note.kind === 'home' ? text.courseHomeTitle(course.title) : `${seoTitle(note)} | ${course.title}`;
const description = noteMetaDescription(note, course, text);
const site = Astro.site ?? new URL('https://joaopster.com');
const courseLd = note.kind === 'home' ? jsonLdScript(courseJsonLd(vault, site)) : undefined;
// Breadcrumbs only where the page can show in search.
const breadcrumbLd =
  indexing === 'index' ? jsonLdScript(noteBreadcrumbJsonLd(note, course, useTranslations(course.lang)('nav.courses'), site)) : undefined;
// A note exists only in its course's language: the language switcher goes to the courses landing of
// the language picked (data-lang-* on <html>, read by i18n/switchLocale.ts).
---

<html lang={course.lang} data-lang-pt={coursesHome('pt')} data-lang-en={coursesHome('en')} data-lang-es={coursesHome('es')}>
  <head>
    <BaseHead title={pageTitle} description={description} alternates="none" indexing={indexing} image={courseOgImage(vault.course)} />
    {courseLd && <script type="application/ld+json" set:html={courseLd} />}
    {breadcrumbLd && <script type="application/ld+json" set:html={breadcrumbLd} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Hidden side panels are applied before the first paint, so the layout does not jump.
         Same key and shape as saveHiddenPanels() in lib/courses/client/reader.ts. -->
    <script is:inline>
      try {
        const saved = JSON.parse(localStorage.getItem('jp-courses:layout') || '{}');
        if (saved.hideNav === true) document.documentElement.classList.add('course-nav-hidden');
        if (saved.hideToc === true) document.documentElement.classList.add('course-toc-hidden');
      } catch {
        // Storage blocked or edited by hand: both panels stay visible.
      }
    </script>
    <!-- With a sync code saved, the sync cards start collapsed (lib/courses/client/syncCard.ts),
         so the right column does not jump. Same key as CODE_KEY in lib/courses/client/sync.ts. -->
    <script is:inline>
      try {
        if (localStorage.getItem('jp-courses:sync-code')) document.documentElement.classList.add('sync-linked');
      } catch {
        // Storage blocked: sync is off and the cards start open, which is right.
      }
    </script>
    <!-- Text size and focus mode are applied before the first paint, so the note does not jump.
         Same key, scales and class as lib/courses/client/readerTools.ts. -->
    <script is:inline>
      try {
        const saved = JSON.parse(localStorage.getItem('jp-courses:reader') || '{}');
        const scale = [0.9, 1, 1.1, 1.2, 1.35][saved.step];
        if (scale) document.documentElement.style.setProperty('--reader-zoom', String(scale));
        if (saved.focus === true) document.documentElement.classList.add('course-focus');
      } catch {
        // Storage blocked or edited by hand: default size, focus mode off.
      }
    </script>
    <!-- The AI assistant stays open from one note to the next in this tab, with the course menu folded
         away if it folded it. Same key and shape as UI_KEY in lib/courses/client/assistant/panel.ts. -->
    <script is:inline>
      try {
        const ui = JSON.parse(sessionStorage.getItem('jp-courses:assistant-ui') || '{}');
        if (ui.open === true) document.documentElement.classList.add('assistant-open');
        if (ui.open === true && ui.hidNav === true) document.documentElement.classList.add('course-nav-hidden');
      } catch {
        // Storage blocked: the assistant starts closed.
      }
    </script>
  </head>
  <body>
    <Header autoHide />
    <ReaderBar lang={course.lang} title={note.title} />
    <main
      class="course-main"
      style={`--course-accent: ${course.look.accent}`}
      data-course={course.slug}
      data-note-url={note.url}
      data-note-kind={note.kind}
      data-outline={courseOutlineUrl(course)}
    >
      <div class="course-layout">
        <aside class="course-rail course-rail--nav" id="course-panel-nav">
          <CourseSidebar vault={vault} note={note} />
        </aside>

        <aside class="course-rail course-rail--toc" id="course-panel-toc">
          <div class="course-rail-inner">
            <SyncCard lang={course.lang} layout="rail" />
            <button type="button" class="assistant-open-btn assistant-open-btn--rail" data-assistant-open aria-controls="course-assistant" aria-expanded="false">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
              <span>{assistant.open}</span>
            </button>
            <TableOfContents headings={headings} variant="rail" title={text.onThisNote} />
          </div>
        </aside>

        <article class="course-article">
          <div class="course-toolbar">
            <button type="button" class="course-panel-toggle course-panel-toggle--nav" data-panel-toggle="nav" aria-controls="course-panel-nav" aria-expanded="true" aria-label={text.hideNav} title={text.hideNav}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg>
            </button>
            <nav class="course-breadcrumb" aria-label={text.youAreHere}>
              <a href={coursesHome(course.lang)}>{text.section}</a>
              <span aria-hidden="true">/</span>
              <a href={vault.home.url}>{course.title}</a>
              {module && note.kind === 'lesson' && (
                <>
                  <span aria-hidden="true">/</span>
                  <a href={module.note.url}>{text.module(module.number)}</a>
                </>
              )}
              {note.kind === 'glossary' && (
                <>
                  <span aria-hidden="true">/</span>
                  <a href={glossaryUrl(course)}>{text.glossary}</a>
                </>
              )}
            </nav>
            <button type="button" class="assistant-open-btn assistant-open-btn--toolbar" data-assistant-open aria-controls="course-assistant" aria-expanded="false" aria-label={assistant.open} title={assistant.open}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
            </button>
            <button type="button" class="course-search-open" data-search-open aria-label={search.open} title={search.open}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <span class="course-search-open-label">{search.open}</span>
              <kbd data-search-shortcut>Ctrl K</kbd>
            </button>
            <ListenButton lang={course.lang} />
            <ReaderTools lang={course.lang} />
            <button type="button" class="course-shortcuts-open course-shortcuts-open--toolbar" data-shortcuts-open aria-haspopup="dialog" aria-controls="course-shortcuts" aria-label={shortcuts.title} title={`${shortcuts.title} (?)`}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/></svg>
            </button>
            <button type="button" class="course-panel-toggle course-panel-toggle--toc" data-panel-toggle="toc" aria-controls="course-panel-toc" aria-expanded="true" aria-label={text.hideToc} title={text.hideToc}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg>
            </button>
            <div class="course-more" data-toolbar-more hidden>
              <button type="button" class="course-more-open" data-toolbar-more-open aria-haspopup="menu" aria-expanded="false" aria-controls="course-more-menu" aria-label={text.moreTools} title={text.moreTools}>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
              </button>
              <div class="course-more-menu" id="course-more-menu" role="menu" aria-label={text.moreTools} data-toolbar-more-menu hidden></div>
            </div>
          </div>

          <SyncCard lang={course.lang} layout="inline" />
          <TableOfContents headings={headings} variant="inline" title={text.onThisNote} />

          {exam && (
            <section class="exam-bar" data-exam-bar data-exam-minutes={exam.minutesPerQuestion} data-exam-target={exam.targetPercent} data-exam-mistakes={mistakesUrl(course)} />
          )}

          {note.kind === 'lesson' && (
            <p class="lesson-time">
              <span>{reader.readingTime(reader.duration(readingMinutes(note)))}</span><span data-lesson-left hidden></span>
            </p>
          )}

          <!-- The only content Pagefind indexes: each note, filtered by course, with its title and kind. -->
          <div data-pagefind-body data-pagefind-filter={`course:${course.slug}`} data-pagefind-meta={`kind:${note.kind}`}>
            <span hidden data-pagefind-meta="title[data-title]" data-title={note.title}></span>
            <div class="prose note-content" set:html={html} />
          </div>
          {note.kind === 'home' && hasStudyPages(course) && (
            <OfflineCard lang={course.lang} studyIndexUrl={studyIndexUrl(course)} course={course.slug} />
          )}
          <slot />

          {note.kind === 'lesson' && (
            <div class="lesson-footer">
              <button type="button" class="lesson-read" data-read-toggle aria-pressed="false">
                <span class="lesson-read-box" aria-hidden="true"></span>
                <span data-read-label>{text.markRead}</span>
              </button>
              <nav class="lesson-pager" aria-label={text.lessons}>
                {previous ? (
                  <a class="lesson-pager-link" href={previous.url} rel="prev">
                    <span class="lesson-pager-dir">{text.previousLesson}</span>
                    <span class="lesson-pager-title">{previous.title}</span>
                  </a>
                ) : <span />}
                {next && (
                  <a class="lesson-pager-link lesson-pager-link--next" href={next.url} rel="next">
                    <span class="lesson-pager-dir">{text.nextLesson}</span>
                    <span class="lesson-pager-title">{next.title}</span>
                  </a>
                )}
              </nav>
            </div>
          )}

          {backlinks.length > 0 && (
            <section class="backlinks" aria-labelledby="backlinks-title">
              <h2 class="backlinks-title" id="backlinks-title">
                {text.mentionedIn} <span>{backlinks.length}</span>
              </h2>
              <ul class="backlinks-list">
                {backlinks.slice(0, BACKLINKS_SHOWN).map((source) => (
                  <li>
                    <a class="wikilink" href={source.url}>{source.title}</a>
                  </li>
                ))}
              </ul>
              {backlinks.length > BACKLINKS_SHOWN && (
                <details class="backlinks-more">
                  <summary>{text.seeMore(backlinks.length - BACKLINKS_SHOWN)}</summary>
                  <ul class="backlinks-list">
                    {backlinks.slice(BACKLINKS_SHOWN).map((source) => (
                      <li>
                        <a class="wikilink" href={source.url}>{source.title}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          )}
        </article>
        <AssistantPanel lang={course.lang} courseTitle={course.title} noteTitle={note.title} />
      </div>
    </main>
    <ListenPlayer lang={course.lang} />
    <ShortcutsDialog lang={course.lang} />
    <KeysDialog lang={course.lang} />
    <CourseTour lang={course.lang} glossaryUrl={glossaryUrl(course)} mistakesUrl={mistakesUrl(course)} reviewUrl={reviewUrl(course)} />
    <Footer />
  </body>
</html>

<script>
  import { initReader } from '../lib/courses/client/reader';
  import { initLinkPreview } from '../lib/courses/client/linkPreview';
  import { renderMermaid } from '../lib/courses/client/mermaid';
  import { initSearch } from '../lib/courses/client/search';
  import { initShortcuts } from '../lib/courses/client/shortcuts';
  import { initReaderBar } from '../lib/courses/client/readerBar';
  import { initOfflineCard, registerOffline } from '../lib/courses/client/offline';
  import { initLessonKeys } from '../lib/courses/client/lessonKeys';
  import { initPrint } from '../lib/courses/client/print';
  import { initReaderTools } from '../lib/courses/client/readerTools';
  import { initToolbar } from '../lib/courses/client/toolbar';
  import { initListen } from '../lib/courses/client/listen/player';
  import { initAssistant } from '../lib/courses/client/assistant/panel';
  import { initKeysDialog } from '../lib/courses/client/keysDialog';

  initSearch();
  initShortcuts();
  initReaderBar();
  initReader();
  initReaderTools();
  initToolbar();
  initListen();
  initLessonKeys();
  initPrint();
  initLinkPreview();
  initKeysDialog();
  const noteUrl = document.querySelector<HTMLElement>('[data-note-url]')?.dataset.noteUrl;
  if (!noteUrl) throw new Error('Course note without its address');
  initAssistant(noteUrl);
  void renderMermaid();
  void registerOffline();
  const offlineCard = document.querySelector<HTMLElement>('[data-offline-card]');
  if (offlineCard) initOfflineCard(offlineCard);
</script>
