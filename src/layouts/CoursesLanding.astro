---
// Courses landing of one language, laid out as a catalog: a short header with the totals, then the
// course list right away, with search (courses, modules and lessons), topic and progress filters,
// sorting, and each course's syllabus one click away. Filtering runs on the page
// (lib/courses/client/catalog.ts). With no course in the language yet, it points to the languages
// that have some.
import BaseHead from '../components/BaseHead.astro';
import CourseEmblem from '../components/courses/CourseEmblem.astro';
import CourseDownloadModal from '../components/CourseDownloadModal.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SyncCard from '../components/courses/SyncCard.astro';
import type { Lang } from '../i18n/ui';
import { COURSE_TOPICS, coursesHome, coursesIn, courseZipUrl, howToUrl, LANGS, sectionAlternates } from '../lib/courses/catalog';
import { catalogCourses } from '../lib/courses/catalogView';
import { siteOgImage } from '../lib/og/siteCards';
import { courseText } from '../lib/courses/i18n';
import { catalogJsonLd, jsonLdScript } from '../lib/courses/seo';
import '../styles/courses.css';
import '../styles/courses-catalog.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = courseText(lang);
const courses = catalogCourses(lang);
// A language with no course of its own has only this page to show: out of search results until it has some.
const indexing = courses.length === 0 ? 'noindex' : 'index';
const itemListLd = courses.length > 0 ? jsonLdScript(catalogJsonLd(courses.map((c) => c.course), Astro.site ?? new URL('https://joaopster.com'))) : undefined;
const otherLanguages = LANGS.filter((l) => l !== lang && coursesIn(l).length > 0);
const totalLessons = courses.reduce((sum, c) => sum + c.lessons, 0);
const totalHours = Math.round(courses.reduce((sum, c) => sum + c.minutes, 0) / 60);
const topics = COURSE_TOPICS.map((topic) => ({
  topic,
  count: courses.filter((c) => c.course.topic === topic).length,
})).filter(({ count }) => count > 0);
const pad = (number: number) => String(number).padStart(2, '0');
// Lessons for the search, by course. "<" is escaped so no title can close the script tag.
const searchIndex = JSON.stringify(Object.fromEntries(courses.map((c) => [c.course.slug, c.searchLessons]))).replace(
  /</g,
  '\\u003c',
);
---

<html lang={lang}>
  <head>
    <BaseHead
      title={text.landingMetaTitle}
      description={text.landingMetaDescription}
      alternates={sectionAlternates(coursesHome)}
      opensIn={LANGS.filter((other) => coursesIn(other).length > 0)}
      image={siteOgImage(lang, 'courses')}
      indexing={indexing}
    />
    {itemListLd && <script type="application/ld+json" set:html={itemListLd} />}
    <!-- With a sync code saved, the sync cards start collapsed (lib/courses/client/syncCard.ts),
         so the side column does not jump. Same key as CODE_KEY in lib/courses/client/sync.ts. -->
    <script is:inline>
      try {
        if (localStorage.getItem('jp-courses:sync-code')) document.documentElement.classList.add('sync-linked');
      } catch {
        // Storage blocked: sync is off and the cards start open, which is right.
      }
    </script>
  </head>
  <body>
    <Header />
    <main class="catalog">
      <header class="catalog-head">
        <p class="courses-eyebrow">{text.section}</p>
        <h1 class="catalog-title">{text.catalogTitle}</h1>
        {courses.length > 0 && <p class="catalog-note">{text.browserLine}</p>}
        {courses.length > 0 && <p class="catalog-facts">{text.catalogFacts(courses.length, totalLessons, totalHours)}</p>}
      </header>

      {courses.length === 0 ? (
        <div class="courses-none">
          <p class="courses-none-title">{text.noCourses}</p>
          {otherLanguages.length > 0 && (
            <>
              <p>{text.otherLanguagesIntro}</p>
              <ul class="courses-none-links">
                {otherLanguages.map((other) => (
                  <li>
                    <a class="course-btn course-btn--secondary" href={coursesHome(other)} hreflang={other}>
                      {text.coursesInLanguage(text.languageNames[other], coursesIn(other).length)}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      ) : (
        <div class="catalog-layout">
          <aside class="catalog-side">
            <form class="catalog-filters" id="catalog-filters" role="search" data-catalog-filters>
              <label class="catalog-search">
                <span class="visually-hidden">{text.searchLabel}</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search" name="q" placeholder={text.searchPlaceholder} autocomplete="off" enterkeyhint="search" aria-keyshortcuts="/" data-catalog-search />
                <kbd aria-hidden="true">/</kbd>
              </label>

              {topics.length > 1 && (
                <fieldset class="catalog-facet">
                  <legend>{text.filterTopic}</legend>
                  <div class="catalog-chips">
                    <label class="catalog-chip">
                      <input type="radio" name="topic" value="" checked />
                      <span>{text.filterAll} <span class="catalog-chip-count">{courses.length}</span></span>
                    </label>
                    {topics.map(({ topic, count }) => (
                      <label class="catalog-chip">
                        <input type="radio" name="topic" value={topic} />
                        <span>{text.topicNames[topic]} <span class="catalog-chip-count">{count}</span></span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}

              <fieldset class="catalog-facet" data-status-facet hidden>
                <legend>{text.filterStatus}</legend>
                <div class="catalog-chips">
                  <label class="catalog-chip">
                    <input type="radio" name="progress" value="" checked />
                    <span>{text.filterAll} <span class="catalog-chip-count">{courses.length}</span></span>
                  </label>
                  <label class="catalog-chip">
                    <input type="radio" name="progress" value="started" />
                    <span>{text.statusStarted} <span class="catalog-chip-count" data-status-count="started"></span></span>
                  </label>
                  <label class="catalog-chip">
                    <input type="radio" name="progress" value="not-started" />
                    <span>{text.statusNotStarted} <span class="catalog-chip-count" data-status-count="not-started"></span></span>
                  </label>
                </div>
              </fieldset>
            </form>

            <a class="catalog-howto" href={howToUrl(lang)}>
              {text.howToLink}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </aside>

          <section class="catalog-results" aria-labelledby="catalog-count">
            <div class="catalog-results-head">
              <h2 class="catalog-count" id="catalog-count" aria-live="polite" data-catalog-count>{text.resultCount(courses.length)}</h2>
              <label class="catalog-sort">
                <span>{text.sortLabel}</span>
                <select name="sort" form="catalog-filters" data-catalog-sort>
                  <option value="recommended">{text.sortRecommended}</option>
                  <option value="title">{text.sortTitle}</option>
                  <option value="shortest">{text.sortShortest}</option>
                  <option value="longest">{text.sortLongest}</option>
                </select>
              </label>
            </div>

            <ol class="catalog-list" data-catalog-list>
              {courses.map(({ course, url, firstLesson, modules, lessons, minutes, terms }, index) => (
                <li
                  class="catalog-course"
                  data-course-card={course.slug}
                  data-topic={course.topic}
                  data-order={index}
                  data-minutes={minutes}
                  data-title={course.title}
                  data-lessons={lessons}
                  data-first-lesson={firstLesson}
                  style={`--course-accent: ${course.look.accent}`}
                  data-search={[course.title, course.goal, course.audience, text.topicNames[course.topic]].join(' ')}
                >
                  <div class="catalog-course-main">
                    <CourseEmblem look={course.look} />
                    <div class="catalog-course-body">
                      <p class="catalog-course-tags">
                        {course.standing === 'flagship'
                          ? <span class="catalog-badge catalog-badge--flagship">{text.flagshipBadge}</span>
                          : <span class="catalog-badge catalog-badge--outline">{text.studyNotesBadge}</span>}
                        <span class="catalog-badge">{text.topicNames[course.topic]}</span>
                        {course.exam && <span class="catalog-badge catalog-badge--outline">{text.examBadge}</span>}
                      </p>
                      <h3 class="catalog-course-title" id={`course-${course.slug}`}><a href={url}>{course.title}</a></h3>
                      <p class="catalog-course-goal">{course.goal}</p>
                      <p class="catalog-course-audience"><strong>{text.audienceLabel}:</strong> {course.audience}</p>
                      <ul class="catalog-course-meta">
                        <li>{text.modulesCount(modules.length)}</li>
                        <li>{text.lessonsCount(lessons)}</li>
                        <li>{text.readingTimeOf(minutes)}</li>
                        <li>{text.levelNames[course.level]}</li>
                        {terms > 0 && <li>{text.termsCount(terms)}</li>}
                      </ul>
                      <div class="catalog-course-progress" data-card-progress hidden>
                        <span class="progress-bar"><span data-card-bar></span></span>
                        <span class="progress-count" data-card-count></span>
                      </div>
                    </div>
                    <div class="catalog-course-actions">
                      <a class="course-btn" href={url} aria-describedby={`course-${course.slug}`} data-card-start>{text.start}</a>
                      <button
                        type="button"
                        class="course-btn course-btn--secondary"
                        aria-expanded="false"
                        aria-controls={`syllabus-${course.slug}`}
                        aria-describedby={`course-${course.slug}`}
                        data-syllabus-toggle
                      >
                        {text.syllabusShow}
                      </button>
                      <button
                        type="button"
                        class="catalog-download"
                        aria-haspopup="dialog"
                        aria-describedby={`course-${course.slug}`}
                        data-download-open
                        data-zip={courseZipUrl(course)}
                        data-title={course.title}
                        data-url={url}
                      >
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"/></svg>
                        {text.downloadZip}
                      </button>
                    </div>
                  </div>

                  <div class="catalog-matches" data-card-matches hidden></div>

                  <div class="catalog-syllabus" id={`syllabus-${course.slug}`} data-syllabus hidden>
                    <div class="catalog-about">
                      <div>
                        <h4 class="catalog-about-title">{text.objectivesLabel}</h4>
                        <ul class="catalog-about-list">
                          {course.objectives.map((objective) => <li>{objective}</li>)}
                        </ul>
                      </div>
                      <div>
                        <h4 class="catalog-about-title">{text.prerequisitesLabel}</h4>
                        {course.prerequisites.length === 0 ? (
                          <p class="catalog-about-none">{text.noPrerequisites}</p>
                        ) : (
                          <ul class="catalog-about-list">
                            {course.prerequisites.map((prerequisite) => <li>{prerequisite}</li>)}
                          </ul>
                        )}
                      </div>
                    </div>
                    <ol class="catalog-modules">
                      {modules.map((module) => (
                        <li data-module={module.number} data-module-url={module.url} data-module-lessons={module.lessons}>
                          <a href={module.url}>
                            <span class="catalog-module-number">{pad(module.number)}</span>
                            <span class="catalog-module-title">{module.title}</span>
                            <span class="catalog-module-meta">
                              <span data-module-done>{text.lessonsCount(module.lessons)}</span> · {text.minutesOfReading(module.minutes)}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </div>
                </li>
              ))}
            </ol>

            <div class="catalog-empty" data-catalog-empty hidden>
              <p>{text.searchEmpty}</p>
              <button type="button" class="course-btn course-btn--secondary" data-catalog-clear>{text.clearFilters}</button>
            </div>
          </section>

          <div class="catalog-sync">
            <SyncCard lang={lang} layout="rail" />
          </div>
        </div>
      )}
    </main>
    <section class="courses-cta-band" aria-labelledby="crie-title">
      <div class="courses-cta">
        <h2 id="crie-title">{text.ctaTitle}</h2>
        <p>{text.ctaText}</p>
        <a class="course-btn course-btn--inverse" href={howToUrl(lang)}>{text.howToLink}</a>
      </div>
    </section>
    <Footer />
    {courses.length > 0 && <CourseDownloadModal lang={lang} />}
    {courses.length > 0 && <script is:inline type="application/json" id="catalog-lessons" set:html={searchIndex} />}
  </body>
</html>

<script>
  import { initCatalog } from '../lib/courses/client/catalog';

  initCatalog();
</script>
