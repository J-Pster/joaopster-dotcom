---
import CourseNotePage from '../../../../components/courses/CourseNotePage.astro';
import { notePage, notFound } from '../../../../lib/courses/requests';

export const prerender = false;

const lookup = await notePage('en', Astro.params, Astro.url);
if (lookup.kind === 'missing') return notFound();
if (lookup.kind === 'redirect') return Astro.redirect(lookup.to, 301);
---

<CourseNotePage {...lookup.page} />
