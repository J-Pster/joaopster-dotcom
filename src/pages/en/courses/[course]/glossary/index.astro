---
import GlossaryIndex from '../../../../../components/courses/GlossaryIndex.astro';
import { coursePage, notFound } from '../../../../../lib/courses/requests';

export const prerender = false;

const lookup = await coursePage('en', Astro.params.course, Astro.url, 'glossary');
if (lookup.kind === 'missing') return notFound();
if (lookup.kind === 'redirect') return Astro.redirect(lookup.to, 301);
---

<GlossaryIndex view={lookup.page} />
