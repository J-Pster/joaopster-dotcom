---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getPostsForLang, ogImagePathOf, slugOf } from '../../../lib/getLatestPost';

export async function getStaticPaths() {
  const posts = await getPostsForLang('en');
  return posts.map((post) => ({
    params: { slug: slugOf(post) },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BlogPost {...post.data} readingTime={readingTime} ogImage={ogImagePathOf(post)} post={post} headings={headings}>
  <Content />
</BlogPost>
