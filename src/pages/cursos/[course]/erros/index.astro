---
import MistakesNotebook from '../../../../components/courses/MistakesNotebook.astro';
import { coursePage, notFound } from '../../../../lib/courses/requests';

export const prerender = false;

const lookup = await coursePage('pt', Astro.params.course, Astro.url, 'study');
if (lookup.kind === 'missing') return notFound();
if (lookup.kind === 'redirect') return Astro.redirect(lookup.to, 301);
---

<MistakesNotebook view={lookup.page} />
