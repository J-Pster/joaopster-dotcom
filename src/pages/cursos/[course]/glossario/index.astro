---
// Glossary index of a course: every term, grouped by initial, with a filter box.
import CourseNote from '../../../../layouts/CourseNote.astro';
import { COURSES } from '../../../../lib/courses/catalog';
import { getVault, type Note } from '../../../../lib/courses/vault';

export function getStaticPaths() {
  return COURSES.filter((c) => getVault(c.slug).glossary.length > 0).map((c) => ({ params: { course: c.slug } }));
}

const vault = getVault(Astro.params.course as string);
const collator = new Intl.Collator('pt-BR', { sensitivity: 'base' });
const initialOf = (term: Note) => term.title.normalize('NFD').charAt(0).toUpperCase();
const aliasesOf = (term: Note): string[] => {
  const aliases = term.frontmatter.aliases;
  return Array.isArray(aliases) ? aliases.filter((a): a is string => typeof a === 'string') : [];
};

const groups = new Map<string, Note[]>();
for (const term of [...vault.glossary].sort((a, b) => collator.compare(a.title, b.title))) {
  const initial = /[A-Z]/.test(initialOf(term)) ? initialOf(term) : '#';
  groups.set(initial, [...(groups.get(initial) ?? []), term]);
}

// The page reuses the reader layout with a synthetic note, so navigation and styles match.
const indexNote: Note = {
  id: 'Glossario',
  name: 'Glossário',
  absPath: '',
  url: `${vault.home.url}glossario/`,
  title: `Glossário: ${vault.course.title}`,
  kind: 'glossary',
  moduleId: undefined,
  frontmatter: {},
  body: '',
};
---

<CourseNote vault={vault} note={indexNote} html="" headings={[]}>
  <div class="glossary-index">
    <h1>Glossário</h1>
    <p class="glossary-lead">
      {vault.glossary.length} termos do curso, cada um com definição, exemplo e as aulas onde aparece.
      Nas aulas, passe o mouse sobre um termo para ver a definição sem sair da página.
    </p>
    <label class="glossary-filter">
      <span class="visually-hidden">Filtrar termos</span>
      <input type="search" placeholder="Filtrar termos" data-glossary-filter autocomplete="off" />
    </label>
    <p class="glossary-empty" data-glossary-empty hidden>Nenhum termo encontrado.</p>
    {[...groups].map(([initial, terms]) => (
      <section class="glossary-group" data-glossary-group>
        <h2 class="glossary-letter">{initial}</h2>
        <ul class="glossary-terms">
          {terms.map((term) => (
            <li data-terms={[term.title, term.name, ...aliasesOf(term)].join(' | ').toLowerCase()}>
              <a class="wikilink" href={term.url}>{term.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</CourseNote>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-glossary-filter]');
  const empty = document.querySelector<HTMLElement>('[data-glossary-empty]');
  if (!input || !empty) throw new Error('Glossary filter markup is missing');
  const fold = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const groups = [...document.querySelectorAll<HTMLElement>('[data-glossary-group]')];
  const items = groups.flatMap((g) => [...g.querySelectorAll<HTMLElement>('li')]).map((li) => ({ li, terms: fold(li.dataset.terms ?? '') }));
  input.addEventListener('input', () => {
    const query = fold(input.value.trim());
    for (const { li, terms } of items) li.hidden = query !== '' && !terms.includes(query);
    for (const group of groups) group.hidden = [...group.querySelectorAll('li')].every((li) => li.hidden);
    empty.hidden = groups.some((g) => !g.hidden);
  });
</script>
