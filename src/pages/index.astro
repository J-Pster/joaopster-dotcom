---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import DarkAboutSection from '../components/sections/DarkAboutSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import FeaturesGridSection from '../components/sections/FeaturesGridSection.astro';
import WorkflowSection from '../components/sections/WorkflowSection.astro';
import RecentPosts from '../components/RecentPosts.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import CTASection from '../components/sections/CTASection.astro';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';
import { getRecentPosts } from '../lib/getLatestPost';
import { getWakatimeData, buildAddendum } from '../lib/getWakatimeData';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const prefix = lang === 'pt' ? '' : `/${lang}`;

const [latestPost, ...morePosts] = await getRecentPosts(lang, 4);
const writeCard = latestPost && {
  pill: t('blog.latestPost'),
  title: latestPost.title,
  dateText: latestPost.pubDate.toLocaleDateString('en-us', { month: 'long', year: 'numeric' }),
  excerpt: latestPost.description,
  href: latestPost.href,
  readMore: t('blog.readPost'),
  readTimeText: `${latestPost.readTime} ${t('blog.minRead')}`,
};

const wakatimeData = await getWakatimeData();
const addendum = buildAddendum(t('workflow.opensource.addendum'), wakatimeData, 'pt-BR');
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={t('site.title')} description={t('site.description')} />
  </head>
  <body>
    <Header />
    <main class="page-sections">
      <HeroSection />
      <DarkAboutSection variant="summary" />
      <ExperienceSection variant="summary" />
      <FeaturesGridSection />
      <WorkflowSection
        variant="write"
        label={t('workflow.write.label')}
        heading={t('workflow.write.heading')}
        citation="- Provérbios 9:9"
        body={t('workflow.write.body')}
        cta={{ text: t('workflow.write.cta'), href: `${prefix}/blog` }}
        flip={true}
        latestPost={writeCard}
      >
        <RecentPosts posts={morePosts} />
        <NewsletterSignup />
      </WorkflowSection>
      <WorkflowSection
        variant="opensource"
        label={t('workflow.opensource.label')}
        heading={t('workflow.opensource.heading')}
        body={t('workflow.opensource.body')}
        addendum={addendum}
        addendumBase={t('workflow.opensource.addendum')}
        locale="pt-BR"
        cta={{ text: t('workflow.opensource.cta'), href: 'https://wakatime.com/@JoaoPster' }}
        wakatimeData={wakatimeData}
      />
      <CTASection />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Full-bleed sections: undo the global main width cap (global.css) that article pages rely on. */
  .page-sections { width: 100%; max-width: none; margin: 0; padding: 0; }
</style>
